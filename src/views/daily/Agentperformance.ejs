                      id="firstDepositNoData"
                      class="text-center mt-3 text-muted"
                      style="display: none"
                    >
                      No matching data found.
                    </p>
                  </div>
                  <button
                    data-deposit-type="first"
                    class="see-more-btn mt-4 btn"
                  >
                    See More <i class="fas fa-chevron-down ms-2"></i>
                  </button>
                </div>
              </div>

              <div class="col">
                <div class="deposit-box">
                  <div>
                    <h2>Second Deposit</h2>
                    <ul id="secondDepositList">
                      </ul>
                    <p
                      id="secondDepositNoData"
                      class="text-center mt-3 text-muted"
                      style="display: none"
                    >
                      No matching data found.
                    </p>
                  </div>
                  <button
                    data-deposit-type="second"
                    class="see-more-btn mt-4 btn"
                  >
                    See More <i class="fas fa-chevron-down ms-2"></i>
                  </button>
                </div>
              </div>

              <div class="col">
                <div class="deposit-box">
                  <div>
                    <h2>Third Deposit</h2>
                    <ul id="thirdDepositList">
                      </ul>
                    <p
                      id="thirdDepositNoData"
                      class="text-center mt-3 text-muted"
                      style="display: none"
                    >
                      No matching data found.
                    </p>
                  </div>
                  <button
                    data-deposit-type="third"
                    class="see-more-btn mt-4 btn"
                  >
                    See More <i class="fas fa-chevron-down ms-2"></i>
                  </button>
                </div>
              </div>
            </div>

            <div
              id="sharedDepositTableContainer"
              class="card p-4 shadow-lg"
              style="display: none"
            >
              <h2 id="sharedTableTitle" class="h5 mb-4 text-dark">
                All Deposits
              </h2>
              <div class="table-responsive table-container">
                <table class="table table-hover shared-table-custom">
                  <thead>
                    <tr>
                      <th>ID</th>
                      <th>Amount</th>
                    </tr>
                  </thead>
                  <tbody id="sharedDepositTableBody">
                    </tbody>
                </table>
                <p
                  id="sharedDepositTableNoData"
                  class="text-center mt-4 text-muted"
                  style="display: none"
                >
                  No matching data found in full list.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/dist/js/adminlte.min.js"></script>

    <script>
      // Tier selection function
      function selectTier(tier) {
        document.getElementById('selectedTier').textContent = tier;
        // Here you would typically filter your data based on the selected tier
        // For now, we'll just log the selection
        console.log('Selected tier:', tier);
        
        // You would call your data loading function here with the tier filter
        // loadAgentData($('#userId').val().trim(), tier);
      }
      
      // Sample Data for Deposits
      const allDeposits = {
        first: [
          { id: 'FD001', amount: 150.00 },
          { id: 'FD002', amount: 200.50 },
          { id: 'FD003', amount: 75.25 },
          { id: 'FD004', amount: 300.00 },
          { id: 'FD005', amount: 120.75 },
          { id: 'FD006', amount: 50.00 },
          { id: 'FD007', amount: 450.00 },
          { id: 'FD008', amount: 90.00 },
          { id: 'FD009', amount: 210.00 },
          { id: 'FD010', amount: 180.50 },
          { id: 'FD011', amount: 600.00 },
          { id: 'FD012', amount: 25.00 },
        ],
        second: [
          { id: 'SD001', amount: 250.00 },
          { id: 'SD002', amount: 350.75 },
          { id: 'SD003', amount: 100.00 },
          { id: 'SD004', amount: 500.00 },
          { id: 'SD005', amount: 180.20 },
          { id: 'SD006', amount: 75.00 },
          { id: 'SD007', amount: 620.00 },
          { id: 'SD008', amount: 110.00 },
        ],
        third: [
          { id: 'TD001', amount: 500.00 },
          { id: 'TD002', amount: 750.00 },
          { id: 'TD003', amount: 200.00 },
          { id: 'TD004', amount: 1000.00 },
          { id: 'TD005', amount: 300.00 },
          { id: 'TD006', amount: 150.00 },
        ],
      };

      let currentActiveDepositType = null; // To keep track of which deposit type's table is currently shown

      /**
       * Renders the initial 5 deposits or all deposits if fewer than 5,
       * and manages the visibility of the "See More" button and "No Data" messages.
       * @param {string} type - The deposit type ('first', 'second', 'third').
       * @param {Array<Object>} data - The array of deposit objects to display.
       */
      function renderInitialDeposits(type, data) {
        const listElement = document.getElementById(`${type}DepositList`);
        const noDataElement = document.getElementById(`${type}DepositNoData`);
        const seeMoreBtn = document.querySelector(
          `.see-more-btn[data-deposit-type="${type}"]`
        );

        listElement.innerHTML = ''; // Clear previous list items
        noDataElement.style.display = 'none'; // Hide no data message by default
        seeMoreBtn.style.display = 'block'; // Show button by default

        const displayData = data.slice(0, 5); // Get first 5 items

        if (displayData.length === 0) {
          noDataElement.style.display = 'block';
          seeMoreBtn.style.display = 'none'; // Hide button if no data
        } else {
          displayData.forEach((deposit) => {
            const listItem = document.createElement('li');
            listItem.className = 'd-flex justify-content-between align-items-center bg-opacity-25 bg-info p-3 rounded';
            listItem.innerHTML = `
                        <span>ID: <strong class="fw-medium">${deposit.id}</strong></span>
                        <span>Amount: <strong class="fw-medium">$${deposit.amount.toFixed(
                          2
                        )}</strong></span>
                    `;
            listElement.appendChild(listItem);
          });

          // Hide "See More" button if there are 5 or fewer items
          if (data.length <= 5) {
            seeMoreBtn.style.display = 'none';
          } else {
            seeMoreBtn.innerHTML = `See More <i class="fas fa-chevron-down ms-2"></i>`;
            seeMoreBtn.classList.remove('active'); // Ensure button is not in 'active' state
          }
        }
      }

      /**
       * Renders all deposits into the shared full table.
       * @param {Array<Object>} data - The array of deposit objects to display.
       */
      function renderSharedTable(data) {
        const tableBody = document.getElementById('sharedDepositTableBody');
        const tableNoData = document.getElementById('sharedDepositTableNoData');
        tableBody.innerHTML = ''; // Clear previous table rows
        tableNoData.style.display = 'none'; // Hide no data message by default

        if (data.length === 0) {
          tableNoData.style.display = 'block';
        } else {
          data.forEach((deposit) => {
            const row = document.createElement('tr');
            row.className = 'table-light'; // Bootstrap class for light row hover
            row.innerHTML = `
                        <td class="py-3 px-4 text-nowrap">${deposit.id}</td>
                        <td class="py-3 px-4 text-nowrap">$${deposit.amount.toFixed(
                          2
                        )}</td>
                    `;
            tableBody.appendChild(row);
          });
        }
      }

      /**
       * Handles the click event for "See More" buttons.
       * Manages visibility of the shared table and updates button states.
       * @param {string} type - The deposit type ('first', 'second', 'third').
       * @param {HTMLElement} clickedButton - The button that was clicked.
       */
      function handleSeeMoreClick(type, clickedButton) {
        const sharedTableContainer = document.getElementById(
          'sharedDepositTableContainer'
        );
        const sharedTableTitle = document.getElementById('sharedTableTitle');

        // Reset all "See More" buttons to default state
        document.querySelectorAll('.see-more-btn').forEach((btn) => {
          btn.innerHTML = `See More <i class="fas fa-chevron-down ms-2"></i>`;
          btn.classList.remove('active');
        });

        if (currentActiveDepositType === type) {
          // If the same button is clicked again, hide the shared table
          sharedTableContainer.style.display = 'none';
          currentActiveDepositType = null;
        } else {
          // Show the shared table and populate it with the selected data
          sharedTableContainer.style.display = 'block';
          currentActiveDepositType = type;

          // Update the title of the shared table
          const titleMap = {
            first: 'All First Deposits',
            second: 'All Second Deposits',
            third: 'All Third Deposits',
          };
          sharedTableTitle.textContent = titleMap[type];

          // Render the shared table with filtered data
          const searchTerm = document
            .getElementById('searchId')
            .value.toLowerCase();
          const filteredData = searchTerm
            ? allDeposits[type].filter((d) =>
                d.id.toLowerCase().includes(searchTerm)
              )
            : allDeposits[type];
          renderSharedTable(filteredData);

          // Update the clicked button's text to "Hide"
          clickedButton.innerHTML = `Hide <i class="fas fa-chevron-up ms-2"></i>`;
          clickedButton.classList.add('active');
        }
      }

      /**
       * Filters the deposit data based on the search term and re-renders the lists/tables.
       */
      function filterDeposits() {
        const searchTerm = document
          .getElementById('searchId')
          .value.toLowerCase();

        // Always update the initial 5 lists in the boxes
        ['first', 'second', 'third'].forEach((type) => {
          const filteredData = allDeposits[type].filter((deposit) =>
            deposit.id.toLowerCase().includes(searchTerm)
          );
          renderInitialDeposits(type, filteredData);
        });

        // If the shared table is currently visible, update its content based on the active type
        if (currentActiveDepositType) {
          const filteredSharedData = allDeposits[
            currentActiveDepositType
          ].filter((deposit) => deposit.id.toLowerCase().includes(searchTerm));
          renderSharedTable(filteredSharedData);
        }
      }

      // Event Listeners
      document.addEventListener('DOMContentLoaded', () => {
        // Initial render of all deposit types
        renderInitialDeposits('first', allDeposits.first);
        renderInitialDeposits('second', allDeposits.second);
        renderInitialDeposits('third', allDeposits.third);

        // Attach event listeners to "See More" buttons
        document.querySelectorAll('.see-more-btn').forEach((button) => {
          button.addEventListener('click', (event) => {
            const type = event.target.dataset.depositType;
            handleSeeMoreClick(type, event.target);
          });
        });

        // Attach event listener for global search input
        document.getElementById('searchId').addEventListener('keyup', filterDeposits);

        // Attach event listener for clear search button
        document.getElementById('clearSearchBtn').addEventListener('click', () => {
          document.getElementById('searchId').value = ''; // Clear input
          filterDeposits(); // Re-run filter to show all data
        });
      });

      $(document).ready(function () {
        // Initialize Chart
        const ctx = document.getElementById('performanceChart').getContext('2d');
        const performanceChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: ['Level 1'],
            datasets: [
              {
                label: 'Deposits',
                data: [5000],
                backgroundColor: '#5ccfcb',
              },
              {
                label: 'Withdrawals',
                data: [500],
                backgroundColor: '#00807c',
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                beginAtZero: true,
              },
            },
          },
        });

        // Load initial data
        loadAgentData();

        // Analyze button click handler
        $('#analyzeBtn').click(function () {
          const userId = $('#userId').val().trim();

          if (!userId) {
            Swal.fire({
              title: 'Error!',
              text: 'Please enter a valid User ID',
              icon: 'error',
              confirmButtonText: 'OK',
            });
            return;
          }

          Swal.fire({
            title: 'Loading Data',
            html: 'Please wait while we fetch agent performance data...',
            allowOutsideClick: false,
            didOpen: () => {
              Swal.showLoading();
            },
          });

          // Simulate API call (replace with actual API call)
          setTimeout(() => {
            Swal.close();
            loadAgentData(userId);
          }, 1500);
        });

        function loadAgentData(userId = '10003') {
          // Sample data - replace with actual API call
          const sampleData = {
            networkSize: 1,
            networkLevels: 1,
            netDeposits: '₹4,500',
            retentionRate: '90.0',
            netProfit: '₹93',
            winRate: '95.8',
            commissionEarned: '₹0',
            commissionRate: '0.0',
            agentInfo: {
              id: userId,
              username: 'MEMBER7876DFJ',
              mobile: '7029934287',
            },
            levelDetails: [
              {
                level: 'Level 1',
                users: 1,
                deposits: '₹5,000',
                withdrawals: '₹500',
                betAmount: '₹2,200',
                winAmount: '₹2,107',
                profitLoss: '₹93',
              },
            ],
          };

          // Update metrics
          $('#networkSize').text(sampleData.networkSize);
          $('#networkLevels').text(sampleData.networkLevels);
          $('#netDeposits').text(sampleData.netDeposits);
          $('#retentionRate').text(sampleData.retentionRate);
          $('#netProfit').text(sampleData.netProfit);
          $('#winRate').text(sampleData.winRate);
          $('#commissionEarned').text(sampleData.commissionEarned);
          $('#commissionRate').text(sampleData.commissionRate);

          // Update agent info
          $('#agentId').text(sampleData.agentInfo.id);
          $('#agentUsername').text(sampleData.agentInfo.username);
          $('#agentMobile').text(sampleData.agentInfo.mobile);

          // Update table
          const tableBody = $('#performanceTable tbody');
          tableBody.empty();

          sampleData.levelDetails.forEach((level) => {
            tableBody.append(`
                        <tr>
                            <td>${level.level}</td>
                            <td>${level.users}</td>
                            <td>${level.deposits}</td>
                            <td>${level.withdrawals}</td>
                            <td>${level.betAmount}</td>
                            <td>${level.winAmount}</td>
                            <td><span class="text-success">${level.profitLoss}</span></td>
                        </tr>
                    `);
          });

          // Update chart
          performanceChart.data.labels = sampleData.levelDetails.map(
            (level) => level.level
          );
          performanceChart.data.datasets[0].data = sampleData.levelDetails.map(
            (level) => parseInt(level.deposits.replace(/[^0-9]/g, ''))
          );
          performanceChart.data.datasets[1].data = sampleData.levelDetails.map(
            (level) => parseInt(level.withdrawals.replace(/[^0-9]/g, ''))
          );
          performanceChart.update();
        }
      });
    </script>
  </body>
