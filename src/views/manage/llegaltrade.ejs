    <script>
      $(document).ready(function () {
        // Initial fetch of all data when the page loads
        fetchUserData();

        // Search Button Click Event for User Violations
        $("#searchBtn").on("click", function () {
          let userId = $("#searchInput").val().trim();
          fetchUserData(userId); // Fetch specific user data
        });

        // History Search Button Click Event
        $("#historySearchBtn").on("click", function () {
          let startDate = $("#startDate").val();
          let endDate = $("#endDate").val();
          fetchHistoryData(startDate, endDate);
        });

        // Clear History Filters Button Click Event
        $("#clearBtn").on("click", function () {
          $("#startDate").val("");
          $("#endDate").val("");
          fetchHistoryData(); // Clear filters and fetch all history
        });

        // Refresh History Button Click Event
        $("#refreshBtn").on("click", function () {
          $("#startDate").val("");
          $("#endDate").val("");
          fetchHistoryData(); // Refresh history data
        });

        // Function to fetch user and history data from API
        function fetchUserData(userId = "") {
          $.ajax({
            type: "POST",
            url: "/api/webapi/get-ligalTrade-data",
            data: { user_id: userId }, // Fetch specific or all data
            dataType: "json",
            success: function (response) {
              //console.log("API Response (Users & History):", response);
              if (response.status && response.data) {
                displayUserData(response.data.users, response.data.history);
                displayHistoryData(response.data.history);
                updateViolationCounts(response.data.users);
              } else {
                console.error(
                  "Invalid response format or no data for users/history."
                );
              }
            },
            error: function (xhr, status, error) {
              console.error(
                "API Fetch Error (Users & History):",
                status,
                error
              );
              Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "Could not fetch user data. Please try again later!",
              });
            },
          });
        }

        // Function to fetch only history data (for date filtering)
        function fetchHistoryData(startDate = "", endDate = "") {
          $.ajax({
            type: "POST", // Assuming history filter also uses POST
            url: "/api/webapi/get-ligalTrade-data", // Or a specific history endpoint
            data: { start_date: startDate, end_date: endDate },
            dataType: "json",
            success: function (response) {
              //console.log("API Response (History Only):", response);
              if (response.status && response.data && response.data.history) {
                displayHistoryData(response.data.history);
              } else {
                console.error(
                  "Invalid response format or no data for history."
                );
              }
            },
            error: function (xhr, status, error) {
              console.error("API Fetch Error (History Only):", status, error);
              Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "Could not fetch history data. Please try again later!",
              });
            },
          });
        }

        // Function to display User Data in Table
        function displayUserData(users, history) {
          let tableBody = $("#userTableBody");
          tableBody.empty(); // Clear existing data

          if (users.length === 0) {
            tableBody.append(
              '<tr><td colspan="7" class="text-center">No user violations found.</td></tr>'
            );
            return;
          }

          users.forEach((user) => {
            let totalScore = user.legal_bet_score;
            let progressPercentage = (totalScore / 10) * 100;
            let progressColor =
              progressPercentage >= 100 ? "#dc3545" : "#00807c"; // Red for 100%, Blue otherwise

            let row = `
              <tr>
                <td>${user.id_user}</td>
                <td>${user.phone}</td>
                <td>${user.legal_bet_score}</td>
                <td>
                  <div class="progress">
                    <div class="progress-bar" style="width: ${progressPercentage}%; background-color: ${progressColor};">
                      ${totalScore}/10
                    </div>
                  </div>
                </td>
                <td>${
                  user.last_illegal_date
                    ? new Date(user.last_illegal_date).toLocaleString()
                    : "N/A"
                }</td>
                <td>
                  ${
                    totalScore >= 10
                      ? `<a class="btn btn-danger btn-sm unlock-btn" data-id="${user.id_user}" href="#"><i class="fa-solid fa-lock-open"></i> Unlock</a>`
                      : `<span class="btn text-success btn-sm"><i class="fa-solid fa-lock"></i> Unblocked</span>`
                  }
                </td>
                <td>
                  <button class="btn btn-info btn-sm show-history-btn" data-id="${
                    user.id_user
                  }">
                    Show History
                  </button>
                </td>
              </tr>
            `;
            tableBody.append(row);
          });
        }

        // Function to display History Data in Table
        function displayHistoryData(history) {
          let tableBody = $("#historyTableBody");
          tableBody.empty(); // Clear existing data

          if (history.length === 0) {
            tableBody.append(
              '<tr><td colspan="6" class="text-center">No violation history found.</td></tr>'
            );
            return;
          }

          history.forEach((entry) => {
            let row = `
              <tr>
                <td>${entry.period}</td>
                <td>${entry.user_id}</td>
                <td>${entry.phone}</td>
                <td>${entry.game}</td>
                <td>${entry.score}</td>
                <td>${new Date(entry.date).toLocaleString()}</td>
              </tr>
            `;
            tableBody.append(row);
          });
        }

        // Function to update violation count cards
        function updateViolationCounts(users) {
          let totalViolations = users.reduce(
            (sum, user) => sum + user.legal_bet_score,
            0
          );
          let activeViolators = users.filter(
            (user) => user.legal_bet_score > 0
          ).length;
          let lockedAccounts = users.filter(
            (user) => user.legal_bet_score >= 10
          ).length;
          let violationRate =
            users.length > 0 ? (totalViolations / users.length).toFixed(2) : 0;
          let activeViolatorsPercent =
            users.length > 0
              ? ((activeViolators / users.length) * 100).toFixed(0)
              : 0;

          $("#totalViolationsCount").text(totalViolations);
          $("#cardTotalViolations").text(totalViolations);
          $("#cardActiveViolators").text(activeViolators);
          $("#activeViolatorsPercent").text(activeViolatorsPercent + "%");
          $("#cardLockedAccounts").text(lockedAccounts);
          $("#cardViolationRate").text(violationRate);
        }

        // Event Delegation for Unlock Button Click
        $(document).on("click", ".unlock-btn", function (e) {
          e.preventDefault();
          let button = $(this);
          let userId = button.data("id");

          Swal.fire({
            title: "Are you sure?",
            text: `Do you want to unlock the account for User ID: ${userId}?`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, unlock it!",
          }).then((result) => {
            if (result.isConfirmed) {
              $.ajax({
                type: "POST",
                url: "/api/webapi/admin/eliga-unblock",
                data: { id: userId },
                dataType: "json",
                success: function (response) {
                  if (response.status) {
                    Swal.fire("Unlocked!", response.message, "success");
                    fetchUserData(); // Refresh table data
                  } else {
                    Swal.fire("Failed!", response.message, "error");
                  }
                },
                error: function (xhr, status, error) {
                  console.error("Unlock API Error:", status, error);
                  Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: "Could not unlock account. Please try again later!",
                  });
                },
              });
            }
          });
        });

        // Event Delegation for Show History buttons
        $(document).on("click", ".show-history-btn", function () {
          let userId = $(this).data("id");
          // Assuming you have the full history data available from the initial fetch
          // Or you can make a new API call to get history for a specific user
          $.ajax({
            type: "POST",
            url: "/api/webapi/get-ligalTrade-data", // Using the same endpoint, filtering on backend
            data: { user_id: userId, get_history_only: true }, // Add a flag for history only
            dataType: "json",
            success: function (response) {
              if (response.status && response.data && response.data.history) {
                showHistoryPopup(response.data.history, userId);
              } else {
                Swal.fire(
                  "No History!",
                  "No violation history found for this user.",
                  "info"
                );
              }
            },
            error: function (xhr, status, error) {
              console.error("Fetch User History Error:", status, error);
              Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "Could not fetch user history. Please try again later!",
              });
            },
          });
        });

        // Function to create and show the history popup
        function showHistoryPopup(userHistory, userId) {
          let modalBodyContent = "";
          if (userHistory.length === 0) {
            modalBodyContent =
              '<p class="text-center">No violation history found for this user.</p>';
          } else {
            modalBodyContent = `
                  <div class="table-responsive">
                      <table class="table table-bordered table-striped">
                          <thead>
                              <tr>
                                  <th>Period ID</th>
                                  <th>Game</th>
                                  <th>Date</th>
                                  <th>Score</th>
                              </tr>
                          </thead>
                          <tbody>
                              ${userHistory
                                .map(
                                  (entry) => `
                                  <tr>
                                      <td>${entry.period}</td>
                                      <td>${entry.game}</td>
                                      <td>${new Date(
                                        entry.date
                                      ).toLocaleString()}</td>
                                      <td>${entry.score}</td>
                                  </tr>
                              `
                                )
                                .join("")}
                          </tbody>
                      </table>
                  </div>
              `;
          }

          let modalContent = `
            <div class="modal fade" id="historyModal" tabindex="-1" role="dialog" aria-labelledby="historyModalLabel" aria-hidden="true">
              <div class="modal-dialog modal-lg" role="document">
                <div class="modal-content">
                  <div class="modal-header bg-info text-white">
                    <h5 class="modal-title" id="historyModalLabel">Violation History for User ID: ${userId}</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                    </button>
                  </div>
                  <div class="modal-body">
                    ${modalBodyContent}
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                  </div>
                </div>
              </div>
            </div>
          `;

          // Append the modal to the body and show it
          $("body").append(modalContent);
          $("#historyModal").modal("show");

          // Clean up after modal is closed
          $("#historyModal").on("hidden.bs.modal", function () {
            $(this).remove();
          });
        }
      });
    </script>
  </body>
</html>
