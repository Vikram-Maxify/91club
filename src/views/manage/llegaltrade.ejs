    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
        margin: 0;
        padding: 0;
      }
      .container-fluid {
        max-width: 1200px;
        margin: auto;
        padding: 20px;
      }

      .header {
        text-align: center;
        background-color: #00807c;
        color: white;
        padding: 10px 0;
        border-radius: 8px;
        margin-bottom: 20px;
      }
      .header h1 {
        margin: 0;
      }
      .dashboard {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
      }
      .card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      }
      .card h3 {
        margin: 0 0 10px;
      }
      .controls {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: flex-end; /* Align items to the bottom */
      }
      .controls .form-control {
        flex-grow: 1; /* Allow inputs to grow */
        min-width: 150px; /* Ensure minimum width for inputs */
      }
      .controls .btn-group {
        display: flex;
        gap: 10px; /* Space between buttons in a group */
      }
      .controls button {
        padding: 10px 20px;
        background-color: #00807c;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s;
      }
      .controls button:hover {
        background-color: #00807c;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: white;
        border-radius: 8px;
      }

      table th,
      table td {
        padding: 10px;
        text-align: left;
        border-bottom: 1px solid #ddd;
      }
      table th {
        background-color: #00807c;
        color: white;
      }
      .progress {
        background-color: #e0e0e0;
        border-radius: 8px;
        overflow: hidden;
        margin-top: 10px;
        height: 20px;
      }
      .progress-bar {
        height: 100%;
        background-color: #00807c;
        text-align: center;
        color: white;
        line-height: 20px; /* Center text vertically */
      }

      /* Responsive adjustments */
      @media (max-width: 768px) {
        .container-fluid {
          padding: 10px;
        }
        .controls {
          flex-direction: column;
          align-items: stretch; /* Stretch items to full width */
        }
        .controls .form-control {
          width: 100%;
        }
        .controls .btn-group {
          flex-direction: column; /* Stack buttons in a group */
          gap: 5px;
        }
        .controls .btn-group button {
          width: 100%;
        }
      }
      @media (max-width: 576px) {
        .d-flex.flex-column.flex-sm-row {
          flex-direction: column !important;
          align-items: flex-start !important;
        }
        .d-flex.flex-column.flex-sm-row .mb-2.mb-sm-0 {
          margin-bottom: 0.5rem !important;
        }
      }
    </style>
