 <script>
      // Global variables
      let agentData = null;
      let currentLevel = 1;
      let performanceChart = null;

      // Level selection function
      function selectLevel(level) {
        currentLevel = parseInt(level.split(' ')[1]);
        document.getElementById('selectedTier').textContent = level;
        document.getElementById('currentLevelTitle').textContent = level;
        
        // Update active class in dropdown
        document.querySelectorAll('.tier-dropdown-menu .dropdown-item').forEach(item => {
          item.classList.remove('active');
        });
        event.target.classList.add('active');
        
        // Update the display for the selected level
        if (agentData) {
          updateLevelData(currentLevel);
        }
      }
      
      // Function to update deposit lists for the current level
      function updateLevelData(levelNum) {
        const levelIndex = levelNum - 1;
        if (!agentData || !agentData.levelDetails[levelIndex]) return;
        
        const levelData = agentData.levelDetails[levelIndex];
        
        // Update deposit lists
        updateDepositList('first', levelData.firstDeposits);
        updateDepositList('second', levelData.secondDeposits);
        updateDepositList('third', levelData.thirdDeposits);
        
        // Update shared table if it's open
        const sharedTableContainer = document.getElementById('sharedDepositTableContainer');
        if (sharedTableContainer.style.display === 'block') {
          const activeBtn = document.querySelector('.see-more-btn.active');
          if (activeBtn) {
            const depositType = activeBtn.dataset.depositType;
            document.getElementById('sharedTableTitle').textContent = 
              `All ${depositType.charAt(0).toUpperCase() + depositType.slice(1)} Deposits - Level ${levelNum}`;
            updateSharedTable(depositType, levelData[`${depositType}Deposits`]);
          }
        }
      }
      
      // Function to update a deposit list
      function updateDepositList(type, deposits) {
        const listElement = document.getElementById(`${type}DepositList`);
        const noDataElement = document.getElementById(`${type}DepositNoData`);
        const seeMoreBtn = document.querySelector(`.see-more-btn[data-deposit-type="${type}"]`);
        
        listElement.innerHTML = '';
        noDataElement.style.display = 'none';
        
        if (!deposits || deposits.length === 0) {
          listElement.innerHTML = '<li class="text-muted">No data</li>';
          if (seeMoreBtn) seeMoreBtn.style.display = 'none';
          return;
        }
        
        // Show first 5 items
        const displayCount = Math.min(deposits.length, 5);
        for (let i = 0; i < displayCount; i++) {
          const deposit = deposits[i];
          const listItem = document.createElement('li');
          listItem.className = 'd-flex justify-content-between align-items-center bg-opacity-25 bg-info p-3 rounded';
          listItem.innerHTML = `
            <span>User ID: <strong>${deposit.userId}</strong></span>
            <span>Amount: <strong>₹${Number(deposit.amount).toLocaleString()}</strong></span>
          `;
          listElement.appendChild(listItem);
        }
        
        // Show "See More" button if there are more than 5 items
        if (seeMoreBtn) {
          if (deposits.length > 5) {
            seeMoreBtn.style.display = 'block';
            seeMoreBtn.innerHTML = `See More <i class="fas fa-chevron-down ms-2"></i>`;
            seeMoreBtn.classList.remove('active');
          } else {
            seeMoreBtn.style.display = 'none';
          }
        }
      }
      
      // Function to update the shared table
      function updateSharedTable(type, deposits) {
        const tableBody = document.getElementById('sharedDepositTableBody');
        const noDataElement = document.getElementById('sharedDepositTableNoData');
        
        tableBody.innerHTML = '';
        noDataElement.style.display = 'none';
        
        if (!deposits || deposits.length === 0) {
          noDataElement.style.display = 'block';
          return;
        }
        
        deposits.forEach(deposit => {
          const row = document.createElement('tr');
          row.className = 'table-light';
          row.innerHTML = `
            <td class="py-3 px-4">${deposit.userId}</td>
            <td class="py-3 px-4">₹${Number(deposit.amount).toLocaleString()}</td>
          `;
          tableBody.appendChild(row);
        });
      }
      
      // Handle "See More" button clicks
      function handleSeeMoreClick(type, clickedButton) {
        const sharedTableContainer = document.getElementById('sharedDepositTableContainer');
        const sharedTableTitle = document.getElementById('sharedTableTitle');
        const levelData = agentData.levelDetails[currentLevel - 1];
        
        // Reset all buttons
        document.querySelectorAll('.see-more-btn').forEach(btn => {
          if (btn !== clickedButton) {
            btn.innerHTML = `See More <i class="fas fa-chevron-down ms-2"></i>`;
            btn.classList.remove('active');
          }
        });
        
        if (clickedButton.classList.contains('active')) {
          // Hide table if already showing this type
          sharedTableContainer.style.display = 'none';
          clickedButton.classList.remove('active');
        } else {
          // Show table with selected deposit type
          sharedTableContainer.style.display = 'block';
          sharedTableTitle.textContent = `All ${type.charAt(0).toUpperCase() + type.slice(1)} Deposits - Level ${currentLevel}`;
          updateSharedTable(type, levelData[`${type}Deposits`]);
          
          // Update button state
          clickedButton.innerHTML = `Hide <i class="fas fa-chevron-up ms-2"></i>`;
          clickedButton.classList.add('active');
        }
      }
      
      // Function to load agent data from API
      async function loadAgentData(userId) {
        try {
          // Show loading indicator
          const swalInstance = Swal.fire({
            title: 'Loading Data',
            html: 'Please wait while we fetch agent performance data...',
            allowOutsideClick: false,
            didOpen: () => {
              Swal.showLoading();
            }
          });
          
          // Make API call
          const response = await fetch(`/api/agent-downline-dashboard?userId=${userId}`);
          
          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          
          agentData = await response.json();
          
          // Validate the response data
          if (!agentData || !agentData.levelDetails) {
            throw new Error('Invalid data format from API');
          }
          
          // Update the UI with the loaded data
          updateUIWithAgentData();
          
          // Close loading indicator
          await swalInstance.close();
        } catch (error) {
          console.error('Error loading agent data:', error);
          Swal.fire({
            title: 'Error!',
            text: 'Failed to load agent data. Please try again.',
            icon: 'error',
            confirmButtonText: 'OK'
          });
        }
      }
      
      // Function to update the UI with the loaded agent data
      function updateUIWithAgentData() {
        if (!agentData) return;
        
        // Update top metrics
        document.getElementById('networkSize').textContent = agentData.networkSize || 0;
        document.getElementById('networkLevels').textContent = agentData.networkLevels || 0;

        // Calculate totals
        const totalDeposits = agentData.levelDetails.reduce((sum, level) => sum + Number(level.deposits || 0), 0);
        const totalWithdrawals = agentData.levelDetails.reduce((sum, level) => sum + Number(level.withdrawals || 0), 0);
        const totalProfit = agentData.levelDetails.reduce((sum, level) => sum + (Number(level.profitLoss) || 0), 0);
        const totalBetAmount = agentData.levelDetails.reduce((sum, level) => sum + (Number(level.betAmount) || 0), 0);
        const totalWinAmount = agentData.levelDetails.reduce((sum, level) => sum + (Number(level.winAmount) || 0), 0);

        // Update metrics
        document.getElementById('netDeposits').textContent = `₹${totalDeposits.toLocaleString()}`;
        document.getElementById('netWithdrawal').textContent = `₹${totalWithdrawals.toLocaleString()}`;
        document.getElementById('netProfit').textContent = `₹${totalProfit.toLocaleString()}`;
        
        // Calculate and display rates
        const retentionRate = totalDeposits > 0 ? ((totalDeposits - totalWithdrawals) / totalDeposits * 100).toFixed(1) : 0;
        const winRate = totalBetAmount > 0 ? (totalWinAmount / totalBetAmount * 100).toFixed(1) : 0;
        const withdrawalRate = totalDeposits > 0 ? (totalWithdrawals / totalDeposits * 100).toFixed(1) : 0;
        
        document.getElementById('retentionRate').textContent = retentionRate;
        document.getElementById('winRate').textContent = winRate;
        document.getElementById('withdrawalRate').textContent = withdrawalRate;
        document.getElementById('commissionRate').textContent = '0.0'; // Assuming this comes from API

        // Update agent info
        document.getElementById('agentId').textContent = agentData.agentInfo?.id || '';
        document.getElementById('agentUsername').textContent = agentData.agentInfo?.username || '';
        document.getElementById('agentMobile').textContent = agentData.agentInfo?.mobile || '';
        document.getElementById('agentBalance').textContent = `₹${Number(agentData.agentInfo?.balance || 0).toLocaleString()}`;
        document.getElementById('agentAccountType').textContent = 'Agent';
        if (agentData.agentInfo?.createdAt) {
          const createdAt = new Date(agentData.agentInfo.createdAt);
          document.getElementById('agentCreatedAt').textContent = createdAt.toLocaleDateString();
        }

        // Update performance table
        const tableBody = document.querySelector('#performanceTable tbody');
        tableBody.innerHTML = '';
        
        agentData.levelDetails.forEach(level => {
          const row = document.createElement('tr');
          const profitLoss = Number(level.profitLoss) || 0;
          const profitClass = profitLoss >= 0 ? 'text-success' : 'text-danger';
          
          row.innerHTML = `
            <td>${level.level}</td>
            <td>${level.users}</td>
            <td>₹${Number(level.deposits || 0).toLocaleString()}</td>
            <td>₹${Number(level.withdrawals || 0).toLocaleString()}</td>
            <td>₹${Number(level.betAmount || 0).toLocaleString()}</td>
            <td>₹${Number(level.winAmount || 0).toLocaleString()}</td>
            <td><span class="${profitClass}">₹${profitLoss.toLocaleString()}</span></td>
          `;
          tableBody.appendChild(row);
        });

        // Update chart
        updateChart();

        // Update deposit lists for current level
        updateLevelData(currentLevel);
      }
      
      // Function to update the chart
      function updateChart() {
        const ctx = document.getElementById('performanceChart').getContext('2d');
        
        // Destroy previous chart if it exists
        if (performanceChart) {
          performanceChart.destroy();
        }
        
        performanceChart = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: agentData.levelDetails.map(level => level.level),
            datasets: [
              {
                label: 'Deposits',
                data: agentData.levelDetails.map(level => Number(level.deposits || 0)),
                backgroundColor: '#5ccfcb',
              },
              {
                label: 'Withdrawals',
                data: agentData.levelDetails.map(level => Number(level.withdrawals || 0)),
                backgroundColor: '#00807c',
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return '₹' + value.toLocaleString();
                  }
                }
              }
            },
            plugins: {
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return context.dataset.label + ': ₹' + context.raw.toLocaleString();
                  }
                }
              }
            }
          },
        });
      }

      // Initialize on page load
      document.addEventListener('DOMContentLoaded', function() {
        // Set up event listeners for "See More" buttons
        document.querySelectorAll('.see-more-btn').forEach(button => {
          button.addEventListener('click', function() {
            const type = this.dataset.depositType;
            handleSeeMoreClick(type, this);
          });
        });
        
        // Set up analyze button
        document.getElementById('analyzeBtn').addEventListener('click', function() {
          const userId = document.getElementById('userId').value.trim();
          if (!userId) {
            Swal.fire({
              title: 'Error!',
              text: 'Please enter a valid User ID',
              icon: 'error',
              confirmButtonText: 'OK',
            });
            return;
          }
          
          loadAgentData(userId);
        });
        
        // Load data for default user ID on page load
        const defaultUserId = document.getElementById('userId').value;
        if (defaultUserId) {
          loadAgentData(defaultUserId);
        }
      });
    </script>
