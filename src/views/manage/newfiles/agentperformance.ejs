    <style>
      /* Custom Dropdown Styles */
      .tier-dropdown-btn {
        background-color: #fff;
        color: #015956;
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 8px 16px;
        min-width: 120px;
        text-align: left;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.2s ease;
      }
      
      .tier-dropdown-btn:hover {
        background-color: #f8f9fa;
        border-color: #adb5bd;
      }
      
      .tier-dropdown-btn:after {
        content: "▼";
        font-size: 0.6em;
        margin-left: 8px;
        transition: transform 0.2s ease;
      }
      
      .tier-dropdown-btn[aria-expanded="true"]:after {
        transform: rotate(180deg);
      }
      
      .tier-dropdown-menu {
        border: 1px solid #ced4da;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 0;
        min-width: 120px;
      }
      
      .dropdown-item {
        color: #015956;
        padding: 8px 16px;
        transition: background-color 0.2s ease;
      }
      
      .dropdown-item:hover, .dropdown-item:focus {
        background-color: #f0f7f6;
        color: #015956;
      }
      
      .dropdown-item.active {
        background-color: #015956;
        color: white;
      }
      
      /* Custom Button Styles */
      .btn-primary-custom {
        background-color: #015956;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        transition: all 0.2s ease;
      }
      
      .btn-primary-custom:hover {
        background-color: #014a47;
        color: white;
      }
      
      /* Form Control Styles */
      .form-control-custom {
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 8px 12px;
      }
      
      /* Card Styles */
      .metric-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        height: 100%;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        text-align: center;
        transition: transform 0.2s ease;
      }
      
      .metric-card:hover {
        transform: translateY(-2px);
      }
      
      .metric-card h3 {
        font-weight: 600;
        color: #015956;
        font-size: 14px;
        margin-bottom: 10px;
      }
      
      .metric-card .value {
        font-size: 1.5rem;
        font-weight: bold;
        color: #00807c;
        margin-bottom: 5px;
      }
      
      .metric-card .subtitle {
        color: #5ccfcb;
        font-size: 13px;
      }
      
      /* Deposit Box Styles */
      .deposit-box {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
      }
      
      .deposit-box h2 {
        font-size: 1.2rem;
        color: #015956;
        margin-bottom: 15px;
      }
      
      .deposit-box ul {
        list-style: none;
        padding: 0;
        margin: 0;
        flex-grow: 1;
      }
      
      .deposit-box ul li {
        margin-bottom: 10px;
        padding: 10px;
        background: rgba(92, 207, 203, 0.1);
        border-radius: 5px;
      }
      
      .see-more-btn {
        background-color: #015956;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        align-self: flex-start;
        margin-top: auto;
      }
      
      .see-more-btn:hover {
        background-color: #014a47;
      }
    </style>
