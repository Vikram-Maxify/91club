<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin Task Control</title>
    
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <style>
        :root {
            --primary: #5ccfcb;
            --primary-dark: #00807c;
            --gradient: linear-gradient(135deg, #5ccfcb, #00807c);
            --text-dark: #1e293b;
            --text-medium: #64748b;
            --text-light: #94a3b8;
            --bg-light: #f8f9fa;
            --bg-white: #ffffff;
            --border-radius: 12px;
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg-light);}
        .container-fluid {padding-top: 2rem; padding-bottom: 2rem;}
        .card {border-radius: var(--border-radius); box-shadow: var(--shadow-sm);}
        .btn-primary {background: var(--gradient); border: none;}
        .btn-dark-blue { background-color: #004080; color: white; }
        .btn-dark-blue:hover { background-color: #002D62; color: white; }
        .balance-card {background: linear-gradient(135deg, #f0f4f8, #e0e6ed);}
        .balance-amount {font-size: 1.5rem; font-weight: 700; color: #002D62;}
        .section-title {font-size: 1.5rem; font-weight: 600; border-left: 5px solid #0d6efd; padding-left: 10px;}
        .accordion-button:not(.collapsed) {background-color: #e7f1ff;}
        .material-icons {vertical-align: middle; margin-right: 0.5rem;}
        .pagination .page-item .page-link { color: var(--text-dark); background-color: var(--bg-white); border: 1px solid #dee2e6; border-radius: 0.25rem; margin: 0 4px; transition: all 0.3s; min-width: 40px; text-align: center; display: flex; align-items: center; justify-content: center; font-weight: 500;}
        .pagination .page-item.active .page-link { background-color: var(--primary); border-color: var(--primary); color: var(--bg-white); font-weight: 700; box-shadow: var(--shadow-sm); transform: translateY(-2px);}
        .pagination .page-item .page-link:hover {background-color: var(--primary-dark); border-color: var(--primary-dark); color: var(--bg-white); box-shadow: var(--shadow-md); transform: translateY(-1px);}
        .pagination .page-item.disabled .page-link {color: var(--text-light); pointer-events: none; background-color: #e9ecef; border-color: #dee2e6; opacity: 0.7;}
        .pagination li:first-child .page-link {border-top-left-radius: 0.25rem; border-bottom-left-radius: 0.25rem;}
        .pagination li:last-child .page-link {border-top-right-radius: 0.25rem; border-bottom-right-radius: 0.25rem;}
        .swal2-popup {font-family: 'Inter', sans-serif;}
        .swal2-confirm.swal2-styled {background-color: #00807c !important; border-color: #00807c !important;}
        .swal2-cancel.swal2-styled {background-color: #6c757d !important; border-color: #6c757d !important;}
        .swal2-progresssteps .swal2-progress-step.swal2-active {background: #00807c !important;}
        .swal2-html-container a {color: #00807c !important;}
    </style>
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
     <%- include('../nav') %>
        <div class="content-wrapper">
            <div class="container-fluid">
                <div class="row mb-4">
                    <div class="col-12">
                        <h1 class="section-title">Transaction History</h1>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="card p-4">
                            <h5 class="card-title mb-3">Date Filter</h5>
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4 col-lg-3">
                                    <label for="timePeriod" class="form-label visually-hidden">Time Period</label>
                                    <select class="form-select" id="timePeriod">
                                        <option selected value="custom">Custom Range</option>
                                        <option value="today">Today</option>
                                        <option value="last7days">Last 7 Days</option>
                                        <option value="last30days">Last 30 Days</option>
                                    </select>
                                </div>
                                <div class="col-md-4 col-lg-3">
                                    <label for="fromDate" class="form-label">From Date</label>
                                    <input type="date" class="form-control" id="fromDate">
                                </div>
                                <div class="col-md-4 col-lg-3">
                                    <label for="toDate" class="form-label">To Date</label>
                                    <input type="date" class="form-control" id="toDate">
                                </div>
                                <div class="col-12 col-lg-3 d-grid">
                                    <button type="button" class="btn btn-primary" id="searchBtn">
                                        <span class="material-icons">search</span>
                                        Search
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 d-flex">
                        <div class="card p-4 w-100 d-flex flex-column justify-content-between">
                            <h5 class="card-title mb-3 text-start">Account Balance</h5>
                            <div class="text-center my-auto">
                                <div class="balance-amount">
                                    <span class="material-icons">monetization_on</span>
                                    <span id="apiCoinsBalance">0</span> API Coins
                                </div>
                            </div>
                            <div class="d-grid mt-1">
                                <button type="button" class="btn btn-dark-blue" id="contactSupportBtn">
                                    <span class="material-icons">chat</span>
                                    Contact Support
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card p-4">
                            <h5 class="card-title mb-3">Transaction Details</h5>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle" id="transactionsTable">
                                    <thead>
                                        <tr>
                                            <th scope="col">Transaction ID</th>
                                            <th scope="col">User</th>
                                            <th scope="col">Date</th>
                                            <th scope="col">Description</th>
                                            <th scope="col">Bet</th>
                                            <th scope="col">win / loss</th>
                                            <th scope="col">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody id="transactionsTbody"></tbody>
                                </table>
                            </div>
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-center mt-3" id="pagination"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JS LIBS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/plugins/jquery/jquery.min.js"></script>
    <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/dist/js/adminlte.min.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
    <script src="/js/admin/admin.js"></script>
    <script>
        // ======== API CONFIG ========
        const API_URL = 'https://zapcore.live/api/history'; // POST endpoint
        const API_KEY = 'gHzzOqoLcoePRim7TID9OpH9PMUJ';  // <-- PUT YOUR ACTUAL KEY HERE
        const PLAYER_ID = ''; // Set to a value if you want to filter

        let currentPage = 1;
        let lastPage = 1;

        // Utility to set default date values and handle time period selection
        function setDefaultDates() {
            let today = new Date();
            let todayStr = today.toISOString().slice(0, 10);
            $('#fromDate').val(todayStr);
            $('#toDate').val(todayStr);
        }

        // Time period dropdown logic (today, last7days, last30days)
        function handleTimePeriodChange() {
            const val = $('#timePeriod').val();
            let today = new Date();
            let fromDate, toDate;

            if (val === 'today') {
                fromDate = toDate = today.toISOString().slice(0, 10);
            } else if (val === 'last7days') {
                let past = new Date(today);
                past.setDate(today.getDate() - 6);
                fromDate = past.toISOString().slice(0, 10);
                toDate = today.toISOString().slice(0, 10);
            } else if (val === 'last30days') {
                let past = new Date(today);
                past.setDate(today.getDate() - 29);
                fromDate = past.toISOString().slice(0, 10);
                toDate = today.toISOString().slice(0, 10);
            } else {
                // custom
                return;
            }
            $('#fromDate').val(fromDate);
            $('#toDate').val(toDate);
        }

        function loadTransactions(page = 1) {
            $('#transactionsTbody').html(`
                <tr>
                    <td colspan="5" class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </td>
                </tr>
            `);
            $('#pagination').html(""); // Clear pagination

            // Fetch date values
            const fromDate = $('#fromDate').val();
            const toDate = $('#toDate').val();

            let data = {
                key: API_KEY,
                page: page,
                limit: 20
            };
            if (PLAYER_ID) data.playerid = PLAYER_ID;
            if (fromDate) data.from_date = fromDate;
            if (toDate) data.to_date = toDate;

            axios.post(API_URL, data)
                .then(res => {
                    if (res.data.status) {
                        const records = res.data.data || [];
                        const pagination = res.data.pagination || {};
                        currentPage = pagination.current_page || 1;
                        lastPage = pagination.last_page || 1;
                        updateTable(records);
                        updatePagination(pagination);
                    } else {
                        $('#transactionsTbody').html(`
                            <tr><td colspan="5" class="text-center text-danger">${res.data.message || "No data found"}</td></tr>
                        `);
                    }
                })
                .catch(() => {
                    $('#transactionsTbody').html(`
                        <tr><td colspan="5" class="text-center text-danger">Error fetching data</td></tr>
                    `);
                });
        }

        function updateTable(records) {
            if (!records || !records.length) {
                $('#transactionsTbody').html('<tr><td colspan="5" class="text-center text-muted">No transactions found.</td></tr>');
                return;
            }
            let html = '';
            records.forEach(item => {
                const dateStr = item.created_at ? item.created_at.split(' ')[0] : '';
                const desc = `${item.game_name} (${item.game_type})<br><small>${item.provider}</small>`;
                const amount = item.win_amount && parseFloat(item.win_amount) > 0
                    ? `<span class="text-success">+${item.win_amount} ${item.currency_code}</span>`
                    : `<span class="text-danger">-${item.bet_amount} ${item.currency_code}</span>`;
                const status = item.status == 1
                    ? '<span class="badge bg-success">Win</span>'
                    : '<span class="badge bg-danger">Lose</span>';
                html += `
                    <tr>
                        <td>#${item.id}</td>
                        <td>${item.player}</td>
                        <td>${dateStr}</td>
                        <td>
                            <img src="${item.icon}" alt="icon" style="width:26px;height:26px;border-radius:4px;margin-right:6px;vertical-align:middle;">
                            ${desc}
                            <div style="font-size:12px;color:#777;">Round: <span>${item.game_round}</span></div>
                        </td>
                        <td>${item.bet_amount}</td>
                        <td>${amount}</td>
                        <td>${status}</td>
                    </tr>
                `;
            });
            $('#transactionsTbody').html(html);
        }

        function updatePagination(pagination) {
            if (!pagination || pagination.last_page <= 1) {
                $('#pagination').html('');
                return;
            }
            let html = '';
            html += `<li class="page-item${currentPage == 1 ? ' disabled' : ''}"><a class="page-link" href="#" data-page="${currentPage-1}">Previous</a></li>`;
            for (let i = 1; i <= pagination.last_page; i++) {
                html += `<li class="page-item${i == currentPage ? ' active' : ''}"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
                if (i >= 5 && i < pagination.last_page) {
                    html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                    html += `<li class="page-item"><a class="page-link" href="#" data-page="${pagination.last_page}">${pagination.last_page}</a></li>`;
                    break;
                }
            }
            html += `<li class="page-item${currentPage == pagination.last_page ? ' disabled' : ''}"><a class="page-link" href="#" data-page="${currentPage+1}">Next</a></li>`;
            $('#pagination').html(html);

            $('#pagination .page-link').off('click').on('click', function (e) {
                e.preventDefault();
                let page = parseInt($(this).data('page'));
                if (!isNaN(page) && page !== currentPage) {
                    loadTransactions(page);
                }
            });
        }

        function loadBalance() {
            let data = { key: API_KEY };
            if (PLAYER_ID) data.playerid = PLAYER_ID;

            axios.post(API_URL, data)
                .then(res => {
                    if (res.data.status) {
                        $('#apiCoinsBalance').text(res.data.Balance);
                    } else {
                        $('#apiCoinsBalance').text("0");
                    }
                })
                .catch(() => {
                    $('#apiCoinsBalance').text("0");
                });
        }

        $(document).ready(function () {
            setDefaultDates();

            loadTransactions();
            loadBalance();

            $('#searchBtn').click(function() {
                loadTransactions(1);
            });

            $('#timePeriod').change(function() {
                handleTimePeriodChange();
            });

            $('#contactSupportBtn').click(function() {
                Swal.fire({
                    title: 'Contact Support',
                    html: `
                        <form id="supportForm">
                            <div class="mb-3">
                                <label class="form-label">Your Email</label>
                                <input type="email" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Message</label>
                                <textarea class="form-control" rows="4" required></textarea>
                            </div>
                        </form>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Send Message',
                    customClass: {
                        confirmButton: 'swal2-confirm swal2-styled',
                        cancelButton: 'swal2-cancel swal2-styled'
                    },
                    preConfirm: () => {
                        return new Promise((resolve) => {
                            if ($('#supportForm')[0].checkValidity()) {
                                resolve();
                            } else {
                                Swal.showValidationMessage('Please fill all required fields');
                            }
                        });
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire('Message Sent!', 'Our support team will contact you shortly.', 'success');
                    }
                });
            });
        });
    </script>
</body>
</html>
