    <style>
        :root {
            --primary: #5ccfcb;
            --primary-dark: #00807c;
            --gradient: linear-gradient(135deg, #5ccfcb, #00807c);
            --text-dark: #2c3e50;
            --text-medium: #64748b;
            --text-light: #94a3b8;
            --bg-light: #f8fafc;
            --bg-white: #ffffff;
            --border-radius: 12px;
            --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);

            /* Custom Risk Colors */
            --risk-low-bg: #e6ffe6;
            --risk-low-text: #28a745;
            --risk-medium-bg: #fffbe6;
            --risk-medium-text: #ffc107;
            --risk-high-bg: #ffe6e6;
            --risk-high-text: #dc3545;

            /* New Darker Colors */
            --dark-background: #343a40;
            --dark-text: #e9ecef;
            --dark-hover: #495057;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            padding-top: 20px;
        }

        .navbar {
            background: var(--gradient);
        }

        .dashboard-header {
            background-color: var(--bg-white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-sm);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            color: var(--text-dark);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .dashboard-header h2 {
            margin-bottom: 0;
            font-size: 1.5rem;
        }

        .card {
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-sm);
            border: none;
            margin-bottom: 1.5rem;
        }

        .card-header {
            background-color: var(--bg-white);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            font-weight: 600;
            border-top-left-radius: var(--border-radius) !important;
            border-top-right-radius: var(--border-radius) !important;
            color: var(--text-dark);
            padding: 1rem 1.5rem;
        }

        .summary-card {
            background-color: var(--bg-white);
            border-radius: var(--border-radius);
            padding: 1.5rem;
            box-shadow: var(--shadow-sm);
            text-align: center;
            height: 100%;
            transition: all 0.3s ease;
            margin-bottom: 1rem;
        }

        .summary-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

        .summary-card .icon {
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .summary-card .value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 0.5rem;
        }

        .summary-card .label {
            font-size: 0.9rem;
            color: var(--text-medium);
        }

        .btn-primary-custom {
            background: var(--gradient);
            border: none;
            color: white;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .btn-primary-custom:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        .nav-tabs {
            border-bottom: none;
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            white-space: nowrap;
            display: flex;
        }

        .nav-tabs .nav-link {
            border-top-left-radius: var(--border-radius);
            border-top-right-radius: var(--border-radius);
            color: var(--text-medium);
            border: 1px solid transparent;
            border-bottom: none;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .nav-tabs .nav-link:hover:not(.active) {
            color: var(--primary);
            border-color: transparent transparent var(--primary);
        }

        .nav-tabs .nav-link.active {
            color: var(--primary-dark);
            background-color: var(--bg-white);
            border-color: #dee2e6 #dee2e6 var(--bg-white);
            font-weight: 600;
        }

        .table-responsive {
            border-radius: var(--border-radius);
            overflow-x: auto;
        }

        .table {
            margin-bottom: 0;
            color: var(--text-dark);
            min-width: 768px;
        }

        .table th, .table td {
            vertical-align: middle;
            padding: 0.75rem;
        }

        .table thead tr {
            background: var(--gradient);
            color: white;
            border-bottom: none;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.03);

        }

        .badge-low-risk {
            background-color: var(--risk-low-bg);
            color: var(--risk-low-text);
            padding: 0.4em 0.8em;
            border-radius: 0.5rem;
            font-weight: 600;
        }

        .badge-medium-risk {
            background-color: var(--risk-medium-bg);
            color: var(--risk-medium-text);
            padding: 0.4em 0.8em;
            border-radius: 0.5rem;
            font-weight: 600;
        }

        .badge-high-risk {
            background-color: var(--risk-high-bg);
            color: var(--risk-high-text);
            padding: 0.4em 0.8em;
            border-radius: 0.5rem;
            font-weight: 600;
        }

        .badge-active {
            background-color: #e0f7fa;
            color: #00bcd4;
            padding: 0.4em 0.8em;
            border-radius: 0.5rem;
            font-weight: 600;
        }

        .badge-blocked {
            background-color: var(--risk-high-bg);
            color: var(--risk-high-text);
            padding: 0.4em 0.8em;
            border-radius: 0.5rem;
            font-weight: 600;
        }

        .action-icon {
            color: var(--text-medium);
            font-size: 1.1rem;
            margin: 0 5px;
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .action-icon:hover {
            color: var(--primary-dark);
        }

        .form-label {
            color: var(--text-dark);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 0.5rem 0.75rem;
            border: 1px solid #e2e8f0;
            color: var(--text-dark);
            font-size: 0.9rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(92, 207, 203, 0.2);
        }

        .input-group-text {
            background-color: #f8f9fa;
            border-radius: 8px 0 0 8px !important;
            color: var(--text-dark);
            padding: 0.5rem 0.75rem;
        }

        /* --- Media Queries for Responsiveness --- */

        /* Extra small devices (phones, 575px and down) */
        @media (max-width: 575.98px) {
            .dashboard-header {
                flex-direction: column;
                align-items: stretch;
                padding: 1rem;
            }

            .dashboard-header h2 {
                margin-bottom: 1rem;
                text-align: center;
            }

            .dashboard-header .btn {
                width: 100%;
                margin-top: 0.5rem;
            }

            .summary-card {
                padding: 1rem;
            }

            .summary-card .value {
                font-size: 1.75rem;
            }

            .nav-tabs {
                display: flex;
                flex-wrap: nowrap;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                -ms-overflow-style: -ms-autohiding-scrollbar;
            }

            .nav-tabs .nav-item {
                flex: 0 0 auto;
            }

            .nav-tabs .nav-link {
                padding: 0.5rem 0.75rem;
                font-size: 0.85rem;
            }

            .card .p-4 {
                padding: 1rem !important;
            }

            .table thead {
                display: none;
            }

            .table tbody, .table tr, .table td {
                display: block;
                width: 100%;
            }

            .table tr {
                margin-bottom: 1rem;
                border: 1px solid #e2e8f0;
                border-radius: var(--border-radius);
                box-shadow: var(--shadow-sm);
                background-color: var(--bg-white);
                padding: 0.75rem;
            }

            .table td {
                text-align: right;
                padding-left: 50%;
                position: relative;
                border-top: 1px solid #f1f1f1;
            }

            .table td::before {
                content: attr(data-label);
                position: absolute;
                left: 0.75rem;
                width: calc(50% - 1.5rem);
                padding-right: 10px;
                white-space: nowrap;
                text-align: left;
                font-weight: 600;
                color: var(--text-dark);
            }

            .table td:last-child {
                border-bottom: none;
            }

            .table .action-icon {
                margin: 0 8px;
                font-size: 1rem;
            }
        }

         @media (max-width: 575.98px) {
            .dashboard-header {
                flex-direction: column;
                align-items: stretch;
                padding: 1rem;
            }

            .dashboard-header h2 {
                margin-bottom: 1rem;
                text-align: center;
            }

            .dashboard-header .btn {
                width: 100%;
                margin-top: 0.5rem;
            }

            .summary-card {
                padding: 1rem;
            }

            .summary-card .value {
                font-size: 1.75rem;
            }

            .nav-tabs {
                display: flex;
                flex-wrap: nowrap;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                -ms-overflow-style: -ms-autohiding-scrollbar;
            }

            .nav-tabs .nav-item {
                flex: 0 0 auto;
            }

            .nav-tabs .nav-link {
                padding: 0.5rem 0.75rem;
                font-size: 0.85rem;
            }

            .card .p-4 {
                padding: 1rem !important;
            }

            /* Improved table styling for mobile */
            .table-responsive {
                border: none;
                padding: 0;
               
            }

            .table {
                min-width: 100%;
                display: block;
                overflow-x: auto;
                white-space: nowrap;
                -webkit-overflow-scrolling: touch;
            }

            .table thead {
                display: none;
            }

            .table tbody {
                display: table;
                width: 100%;
            }

            .table tr {
                display: table-row;
                border-bottom: 1px solid #e2e8f0;
                margin-bottom: 0;
                box-shadow: none;
                background-color: transparent;
                padding: 0;
            }

            .table td {
                display: table-cell;
                padding: 0.75rem;
                text-align: left;
                position: static;
                border-top: none;
                white-space: normal;
            }

            .table td::before {
                content: none;
            }

            /* Add visual separation between rows */
            .table tbody tr {
                border-bottom: 15px solid var(--bg-light);
            }

            /* Highlight the first column (IP Address) */
            .table td:first-child {
                font-weight: 600;
                color: var(--text-dark);
            }

            /* Adjust action icons */
            .table .action-icon {
                margin: 0 5px;
                font-size: 1rem;
            }
        }

        /* Small devices (landscape phones, 576px and up) */
        @media (min-width: 576px) and (max-width: 767.98px) {
            .dashboard-header {
                flex-direction: row;
                align-items: center;
                padding: 1.25rem;
            }

            .dashboard-header h2 {
                margin-bottom: 0;
                font-size: 1.5rem;
            }

            .summary-card {
                padding: 1.25rem;
            }

            .nav-tabs .nav-link {
                padding: 0.5rem 0.75rem;
                font-size: 0.9rem;
            }

            .table td, .table th {
                padding: 0.5rem;
            }

            /* Adjust table for medium-small screens */
            .table-responsive {
                overflow-x: auto;
            }

            .table {
                min-width: 100%;
                display: table;
            }

            .table thead {
                display: table-header-group;
            }

            .table tbody {
                display: table-row-group;
            }

            .table tr {
                display: table-row;
            }

            .table td, .table th {
                display: table-cell;
            }
        }
    </style>
</head>

