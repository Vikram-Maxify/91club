    <script>
        $(document).ready(function() {
            // Load initial data
            loadIpData();

            // Refresh button click handler
            $('#refreshBtn').click(function() {
                Swal.fire({
                    title: 'Refreshing Data',
                    html: 'Please wait while we update the IP intelligence data...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Simulate API call (replace with actual API call)
                setTimeout(() => {
                    Swal.close();
                    loadIpData();
                    Swal.fire({
                        title: 'Success!',
                        text: 'Data has been refreshed successfully',
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false
                    });
                }, 1500);
            });

           

            // Block IP action
            $(document).on('click', '.block-ip', function() {
                const ipAddress = $(this).data('ip');

                Swal.fire({
                    title: 'Block IP Address?',
                    text: `Are you sure you want to block ${ipAddress}?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, block it!',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#d33',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Simulate API call to block IP
                        setTimeout(() => {
                            Swal.fire(
                                'Blocked!',
                                `IP address ${ipAddress} has been blocked.`,
                                'success'
                            );
                            loadIpData(); // Refresh data
                        }, 800);
                    }
                });
            });

            // View details action
            $(document).on('click', '.view-details', function() {
                const ipAddress = $(this).data('ip');

                Swal.fire({
                    title: `Details for ${ipAddress}`,
                    html: `
                        <div class="text-start">
                            <p><strong>Location:</strong> Asansol, IN</p>
                            <p><strong>ISP:</strong> Example ISP</p>
                            <p><strong>First Seen:</strong> 2023-01-01</p>
                            <p><strong>Last Activity:</strong> 2023-01-15</p>
                            <p><strong>Risk Score:</strong> 25/100 (Low)</p>
                        </div>
                    `,
                    confirmButtonText: 'Close',
                    width: '600px'
                });
            });

            let allIpData = []; // store raw data globally

function loadIpData() {
  $.ajax({
    url: "/api/ip-records",
    method: "GET",
    dataType: "json",
    success: function (resp) {
      allIpData = resp.data; // keep original data
      renderTable(allIpData);

      // Update summary cards
      $('#totalIps').text(resp.summary.totalActiveIps);
      $('#highRiskIps').text(resp.summary.highRiskIps);
      $('#activeUsers').text(resp.summary.activeUsers);
    },
    error: function () {
      alert("Failed to load IP data");
    }
  });
}

function renderTable(data) {
  const tableBody = $('#ipTable tbody');
  tableBody.empty();

  data.forEach(ip => {
    // Risk badge
    let riskBadge = '';
    if (ip.risk === 'Normal') {
      riskBadge = '<span class="badge badge-normal">Normal</span>';
    } else if (ip.risk === 'High') {
      riskBadge = '<span class="badge badge-high-risk">High</span>';
    } else if (ip.risk === 'Low') {
      riskBadge = '<span class="badge badge-low-risk">Low</span>';
    }

    // Phone list
    let phoneList = '';
    if (ip.phones && ip.phones.length > 0) {
      phoneList = '<ul class="phone-list">';
      ip.phones.forEach(p => {
        phoneList += `<li>${p}</li>`;
      });
      phoneList += '</ul>';
    } else {
      phoneList = '<em>No users</em>';
    }

    // Append row
    tableBody.append(`
      <tr>
          <td data-label="IP Address">${ip.ip}</td>
          <td data-label="Risk Level">${riskBadge}</td>
          <td data-label="Total Activities">${ip.activities}</td>
          <td data-label="Unique Users">${ip.users}</td>
          <td data-label="Users & Actions">${phoneList}</td>
          <td data-label="Last Activity">${ip.lastActivity}</td>
          <td data-label="Actions">
              <button class="btn btn-sm btn-info check-location" data-ip="${ip.ip}">
                <i class="fas fa-map-marker-alt"></i> Check Location
              </button>
          </td>
      </tr>
    `);
  });

  // Re-bind location buttons
  $('.check-location').off('click').on('click', function () {
    const ip = $(this).data('ip');
    const btn = $(this);

    btn.prop('disabled', true).text("Loading...");
    $.get(`https://ipwho.is/${ip}`, function (res) {
      if (res && res.success) {
        alert(`📍 IP: ${ip}\nCountry: ${res.country}\nCity: ${res.city}\nISP: ${res.connection?.isp || 'N/A'}`);
      } else {
        alert(`❌ Could not fetch location for ${ip}`);
      }
    }).always(() => {
      btn.prop('disabled', false).html('<i class="fas fa-map-marker-alt"></i> Check Location');
    });
  });
}

// 🔎 Filter logic
function applyFilters() {
  let filtered = allIpData;

  // Search (IP or location)
  const search = $('#searchIp').val().toLowerCase();
  if (search) {
    filtered = filtered.filter(item =>
      item.ip.toLowerCase().includes(search) ||
      (item.location && item.location.toLowerCase().includes(search))
    );
  }

  // Risk level
  const risk = $('#riskLevel').val();
  if (risk !== "all") {
    filtered = filtered.filter(item => item.risk === risk);
  }

  // Activity type (check if in phones/actions list)
  const activityType = $('#activityType').val();
  if (activityType !== "all") {
    filtered = filtered.filter(item =>
      item.phones && item.phones.some(p => p.toLowerCase().includes(activityType.toLowerCase()))
    );
  }

  // Time range filter
  const range = $('#timeRange').val();
  if (range !== "all") {
    const now = new Date();
    filtered = filtered.filter(item => {
      if (!item.lastActivity) return false;
      const last = new Date(item.lastActivity);
      if (range === "24h") return (now - last) <= 24 * 60 * 60 * 1000;
      if (range === "7d") return (now - last) <= 7 * 24 * 60 * 60 * 1000;
      if (range === "30d") return (now - last) <= 30 * 24 * 60 * 60 * 1000;
      return true;
    });
  }

  renderTable(filtered);
}

// Bind filter events
$('#searchIp, #riskLevel, #activityType, #timeRange').on('input change', applyFilters);



        });
