  </head>
  <body class="hold-transition sidebar-mini">
    <div class="wrapper">
      <!-- Navigation include (replace as needed) -->
      <%- include('../nav') %>

      <div class="content-wrapper">
        <div class="container ">
          <div class="container-fluid py-4">
            <div class="row align-items-center mb-4">
              <div class="col-md-8">
                <h3 class="mb-1">Top Performers</h3>
                <p class="text-muted mb-0">
                  Analyzing player performance and activity metrics
                </p>
              </div>
              <div class="col-md-4 text-md-end">
                <div class="d-flex justify-content-end align-items-center">
                  <span class="text-muted me-2" style="font-size: 0.9rem">Time Frame</span>
                  <div class="dropdown me-2">
                    <button class="btn dropdown-toggle rounded-pill px-3" type="button" id="timeFrameDropdown"
                      data-bs-toggle="dropdown" aria-expanded="false"
                      style="background-color: white; color: green; border: 1px solid green;">
                      <span id="dropdownLabel" style=" font-weight:bold;">Today</span> <i class="fas fa-chevron-down ms-2"></i>
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="timeFrameDropdown" style="background-color: white !important;">
                      <li><div class="dropdown-item" onclick="setTimeFrame('Today')">Today</div></li>
                      <li><div class="dropdown-item" onclick="setTimeFrame('This Week')">This Week</div></li>
                      <li><div class="dropdown-item" onclick="setTimeFrame('This Month')">This Month</div></li>
                      <li><div class="dropdown-item" onclick="setTimeFrame('This Year')">This Year</div></li>
                      <li><div class="dropdown-item" onclick="setTimeFrame('All Time')">All Time</div></li>
                    </ul>
                  </div>
                  <button class="btn btn-light rounded-circle" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;" onclick="reloadPerformers()">
                    <i class="fas fa-redo-alt"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- Summary Cards -->
            <div class="row mb-4 g-3" id="summaryCards">
              <div class="col-lg-3 col-md-6 col-sm-12">
                <div class="card summary-card deposits">
                  <div class="card-body">
                    <div class="icon-wrapper"><i class="fas fa-dollar-sign"></i></div>
                    <div>
                      <p class="card-title">Total Deposits</p>
                      <h6 class="card-text" id="totalDeposits">₹0</h6>
                      <small class="text-muted">Across all performers</small>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6 col-sm-12">
                <div class="card summary-card roi">
                  <div class="card-body">
                    <div class="icon-wrapper"><i class="fas fa-chart-line"></i></div>
                    <div>
                      <p class="card-title">Average withdrawals Ratio</p>
                      <h6 class="card-text" id="averageWithdrawRatio">0.00%</h6>
                      <small class="text-muted">Return on investment</small>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6 col-sm-12">
                <div class="card summary-card bets">
                  <div class="card-body">
                    <div class="icon-wrapper"><i class="fas fa-dice"></i></div>
                    <div>
                      <p class="card-title">Total Bets</p>
                      <h6 class="card-text" id="totalBets">0</h6>
                      <small class="text-muted">Combined activity</small>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-3 col-md-6 col-sm-12">
                <div class="card summary-card win-rate">
                  <div class="card-body">
                    <div class="icon-wrapper"><i class="fas fa-trophy"></i></div>
                    <div>
                      <p class="card-title">Avg Win Rate</p>
                      <h6 class="card-text" id="averageWinRate">0.00%</h6>
                      <small class="text-muted">Success rate</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Top Performers List -->
            <div class="row g-4" id="performerCardsContainer"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- JS dependencies -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/plugins/jquery/jquery.min.js"></script>
    <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/dist/js/adminlte.min.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
    <script src="/js/admin/admin.js"></script>

    <script>
      let currentInterval = "today";

function setTimeFrame(label) {
  document.getElementById("dropdownLabel").textContent = label;
  switch (label) {
    case "Today": currentInterval = "today"; break;
    case "This Week": currentInterval = "week"; break;
    case "This Month": currentInterval = "month"; break;
    case "This Year": currentInterval = "year"; break;
    case "All Time": currentInterval = "all"; break;
    default: currentInterval = "today";
  }
  fetchAndRenderPerformers();
}

function reloadPerformers() {
  fetchAndRenderPerformers();
}

function formatAmount(amount) {
  // Always returns string with ₹ and commas
  return "₹" + Number(amount || 0).toLocaleString();
}

function fetchAndRenderPerformers() {
  // Loading state
  $("#performerCardsContainer").html('<div class="col-12 text-center"><div class="spinner-border text-success" role="status"></div></div>');
  $.get(`/api/top-performers?interval=${currentInterval}&limit=10`, function(data) {
    // Calculate summaries
    let totalDeposits = 0, totalBets = 0, avgWithdrawRatio = 0, avgWinRate = 0;
    data.forEach(user => {
      totalDeposits += Number(user.deposits.amount) || 0;
      totalBets += Number(user.betting.bets) || 0;
      avgWithdrawRatio += Number(user.withdrawals.ratio) || 0;
      avgWinRate += Number(user.betting.winRate) || 0;
    });
    const n = data.length || 1;
    $("#totalDeposits").text(formatAmount(totalDeposits));
    $("#totalBets").text(totalBets.toLocaleString());
    $("#averageWithdrawRatio").text((avgWithdrawRatio/n).toFixed(2) + "%");
    $("#averageWinRate").text((avgWinRate/n).toFixed(2) + "%");

    renderPerformerCards(data);
  }).fail(function(xhr) {
    $("#performerCardsContainer").html('<div class="col-12 text-center text-danger">Failed to load data.</div>');
  });
}

function renderPerformerCards(data) {
  const container = document.getElementById('performerCardsContainer');
  container.innerHTML = '';
  if (!data.length) {
    container.innerHTML = '<div class="col-12 text-center text-muted">No performers in this time frame.</div>';
    return;
  }
  data.forEach((performer) => {
    const withdrawRatio = (typeof performer.withdrawals.ratio === 'number' && !isNaN(performer.withdrawals.ratio)) ? performer.withdrawals.ratio : 0;
    const cardHtml = `
      <div class="col-lg-4 col-md-6 col-sm-12">
          <div class="card performer-card h-100">
              <div class="card-header">
                  <div>
                      <span class="rank-badge"><i class="fas fa-medal me-1"></i>Rank #${performer.rank}</span>
                      <small class="text-muted ms-2">Elite</small>
                  </div>
                  <div class="progress-bar-container">
                      <div class="progress-bar-fill" style="width: ${withdrawRatio > 100 ? 100 : withdrawRatio}%;"></div>
                  </div>
                  <span class="text-success fw-bold" style="font-size: 0.9rem;">${withdrawRatio}%</span>
              </div>
              <div class="card-body">
                  <div class="performer-info mb-3">
                      <h5>${performer.name}</h5>
                      <p><i class="fas fa-phone-alt"></i>${performer.phone} <span class="badge ${performer.status === 'Active' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary'} ms-2">${performer.status}</span></p>
                  </div>
                  <div class="row">
                      <div class="col-6">
                          <div class="mini-card deposits">
                              <div>
                                  <div class="label">Total Deposits</div>
                                  <div class="value">${formatAmount(performer.deposits.amount)}</div>
                                  <small class="text-muted">${performer.deposits.transactions} transactions</small>
                              </div>
                              <i class="fas fa-arrow-down icon"></i>
                          </div>
                      </div>
                      <div class="col-6">
                          <div class="mini-card withdrawals">
                              <div>
                                  <div class="label">Total Withdrawals</div>
                                  <div class="value">${formatAmount(performer.withdrawals.amount)}</div>
                                  <small class="text-muted">${withdrawRatio}% ratio</small>
                              </div>
                              <i class="fas fa-arrow-up icon"></i>
                          </div>
                      </div>
                      <div class="col-6">
                          <div class="mini-card betting">
                              <div>
                                  <div class="label">Betting Activity</div>
                                  <div class="value">${(performer.betting.bets || 0).toLocaleString()} bets</div>
                                  <small class="text-muted">${performer.betting.winRate !== null && performer.betting.winRate !== undefined ? performer.betting.winRate + '%' : '--'} win rate</small>
                              </div>
                              <i class="fas fa-hand-holding-usd icon"></i>
                          </div>
                      </div>
                      <div class="col-6">
                          <div class="mini-card balance">
                              <div>
                                  <div class="label">Current Balance</div>
                                  <div class="value">${formatAmount(performer.balance.amount)}</div>
                                  <small class="text-muted">${withdrawRatio}% Withdraw Ratio</small>
                              </div>
                              <i class="fas fa-wallet icon"></i>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', cardHtml);
  });
}

// Initial render on page load
document.addEventListener('DOMContentLoaded', fetchAndRenderPerformers);

    </script>
  </body>
</html>
