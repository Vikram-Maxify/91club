     <!-- ========== CORRECTED SCRIPT SECTION ========== -->
  <!-- jQuery (ONLY ONCE) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  
  <!-- Bootstrap Bundle with Popper (CHOOSE ONE VERSION) -->
  <!-- Option 1: Use CDN version -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- OR Option 2: Use local version (comment out the CDN version above) -->
  <!-- <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script> -->
  
  <!-- SweetAlert2 (ONLY ONCE) -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <!-- Axios -->
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  
  <!-- AdminLTE (ONLY ONCE) -->
  <script src="/dist/js/adminlte.min.js"></script>
  
  <!-- Your custom admin script (ONLY ONCE) -->
  <script src="/js/admin/admin.js"></script>

    <script>
        // Helper function for SweetAlert2 messages
        const showAlert = (icon, title, text, timer = 2500) => {
            Swal.fire({
                icon: icon,
                title: title,
                text: text,
                showConfirmButton: false,
                timer: timer,
                timerProgressBar: true
            });
        };

        /**
         * Fetches VIP data from the API and populates the "Edit Levels" table.
         */
        async function fetchAndPopulateEditLevels() {
            const tableBody = document.getElementById('levels-edit-table-body');
            tableBody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: var(--text-medium);">Loading VIP data...</td></tr>'; // Loading state

            try {
                const response = await axios.get('/api/webapi/vip-data');
                const responseData = response.data;

                if (responseData.success && responseData.data.length > 0) {
                    tableBody.innerHTML = ''; // Clear loading state

                    responseData.data.forEach(item => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td>${item.level}</td>
                            <td><input type="number" value="${item.amount}" class="form-control amount"></td>
                            <td><input type="number" value="${item.onetime}" class="form-control onetime"></td>
                            <td>${item.level}</td> <td><input type="number" value="${item.monthstime}" class="form-control monthstime"></td>
                            <td><input type="number" step="0.01" value="${item.rebet}" class="form-control rebet"></td>
                            <td><input type="number" step="0.01" value="${item.sefe}" class="form-control sefe"></td>
                            <td>
                                <button class="update-btn" data-id="${item.id}">
                                    <i class="fas fa-save"></i> Update
                                </button>
                            </td>
                        `;
                        tableBody.appendChild(row);
                    });
                } else {
                    tableBody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: var(--danger-color);">No VIP data found or an error occurred.</td></tr>';
                    showAlert('warning', 'No Data', responseData.message || 'Could not load VIP data.');
                }
            } catch (error) {
                console.error('Error fetching VIP data for edit:', error);
                tableBody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: var(--danger-color);">Failed to load VIP data. Please check network.</td></tr>';
                showAlert('error', 'Network Error', 'Failed to fetch VIP data. Please try again.');
            }
        }

        /**
         * Handles the update action when an "Update" button is clicked.
         */
        document.getElementById('levels-edit-table-body').addEventListener('click', async (e) => {
            if (e.target.closest('.update-btn')) {
                const button = e.target.closest('.update-btn');
                const originalButtonContent = button.innerHTML; // Store original content including icon
                button.disabled = true; // Disable button
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...'; // Feedback

                const row = button.closest('tr');
                // Use Array.from for robust conversion from HTMLCollection to Array for find
                const cells = Array.from(row.querySelectorAll('td'));
                // Find the level based on its position or a specific class/attribute if available
                // Assuming 'Level' is the first cell based on your table structure
                const level = cells[0].textContent; // Get level from the first cell

                const id = button.dataset.id;

                // Get values from input fields, ensure they are numbers
                const amount = parseFloat(row.querySelector('.amount').value);
                const onetime = parseFloat(row.querySelector('.onetime').value);
                const monthstime = parseFloat(row.querySelector('.monthstime').value);
                const rebet = parseFloat(row.querySelector('.rebet').value);
                const sefe = parseFloat(row.querySelector('.sefe').value);

                // Basic validation
                if (isNaN(amount) || isNaN(onetime) || isNaN(monthstime) || isNaN(rebet) || isNaN(sefe)) {
                    showAlert('error', 'Invalid Input', 'Please enter valid numbers for all fields.');
                    button.disabled = false;
                    button.innerHTML = originalButtonContent;
                    return;
                }

                const updatedData = {
                    id,
                    level: level, // Include level if your API expects it in the update payload
                    amount,
                    onetime,
                    monthstime,
                    rebet,
                    sefe
                };

                try {
                    const response = await axios.post('/api/webapi/set-vip-data', updatedData, {
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });
                    const responseData = response.data;

                    if (responseData.status) {
                        showAlert('success', 'Success', 'VIP data updated successfully!');
                        // Optional: Re-fetch data for the "View Current" tab if it's open, or just refresh this row
                    } else {
                        showAlert('error', 'Failed', responseData.message || 'Failed to update VIP data.');
                    }
                } catch (error) {
                    console.error('Error updating VIP data:', error);
                    showAlert('error', 'API Error', 'An error occurred while updating data. Please try again.');
                } finally {
                    button.disabled = false; // Re-enable button
                    button.innerHTML = originalButtonContent; // Reset button text
                }
            }
        });

        /**
         * Fetches VIP data and displays it in the "View Current" tab (read-only).
         */
        async function fetchAndPopulateViewLevels() {
            const tableBody = document.getElementById('levels-view-table-body');
            tableBody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-medium);">Loading current levels...</td></tr>';

            try {
                const response = await axios.get('/api/webapi/vip-data');
                const responseData = response.data;

                if (responseData.success && responseData.data.length > 0) {
                    tableBody.innerHTML = ''; // Clear loading state
                    responseData.data.forEach(item => {
                        const row = document.createElement('tr');
                        row.innerHTML = `
                            <td>${item.level}</td>
                            <td>${item.amount}</td>
                            <td>${item.onetime}</td>
                            <td>${item.level}</td> <td>${item.monthstime}</td>
                            <td>${item.rebet}%</td>
                            <td>${item.sefe}%</td>
                        `;
                        tableBody.appendChild(row);
                    });
                } else {
                    tableBody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--danger-color);">No current VIP data available.</td></tr>';
                    showAlert('warning', 'No Data', responseData.message || 'No current VIP data to display.');
                }
            } catch (error) {
                console.error('Error fetching VIP data for view:', error);
                tableBody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--danger-color);">Failed to load current VIP data.</td></tr>';
                showAlert('error', 'Network Error', 'Failed to fetch current VIP data. Please try again.');
            }
        }

        // Tab switching logic
        const tabs = document.querySelectorAll('.tab');
        const tabContents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                // Remove active class from all tabs and contents
                tabs.forEach(t => t.classList.remove('active'));
                tabContents.forEach(tc => tc.classList.remove('active'));

                // Add active class to the clicked tab and its corresponding content
                tab.classList.add('active');
                const targetTabContentId = tab.getAttribute('data-tab');
                document.getElementById(targetTabContentId).classList.add('active');

                // If "View Current" tab is clicked, fetch and display the data
                if (targetTabContentId === 'view-levels') {
                    fetchAndPopulateViewLevels();
                }
            });
        });

        // Initial data fetch and display for "Edit Levels" on page load
        document.addEventListener('DOMContentLoaded', () => {
            fetchAndPopulateEditLevels();
        });

        // Back to top button logic
        const backToTopButton = document.getElementById('back-to-top');
        if (backToTopButton) {
            window.addEventListener('scroll', () => {
                if (window.scrollY > 200) { // Show button after scrolling 200px
                    backToTopButton.style.display = 'flex';
                } else {
                    backToTopButton.style.display = 'none';
                }
            });

            backToTopButton.addEventListener('click', (e) => {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }
    </script>
   

    
  </body>
</html>



