    <div class="col-12 col-sm-6 col-lg-3">
        <button class="action-button btn-red" id="ban-user">
            <i class="fas fa-ban icon"></i>Ban User
        </button>
    </div>
</div>



                <!-- Profile and Bank Information -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card profile-card">
                            <div class="card-body box-profile">
                                <div class="text-center">
                                    <img class="profile-user-img img-fluid img-circle" src="/images/facebook.png" alt="User profile picture">
                                </div>
                        
                                <h3 class="profile-username text-center" id="member-name">Loading...</h3>
                        
                                <p class="text-center" id="id_user">ID: Loading...</p>
                        
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <b>Surplus</b> <a id="money">0</a>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Total Recharge</b> <a id="total_money">0</a>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Total Withdrawal</b> <a id="total_withdraw">0</a>
                                    </li>
                                    <li class="list-group-item">
                                        <b>General Invitation</b> <a id="total_mem">0</a>
                                    </li>
                                    <li class="list-group-item">
                                        <b>IP</b> <a id="ip">Loading...</a>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Inviter</b> <a id="invite">Loading...</a>
                                    </li>
