                            <div class="card-header">
                                <h3 class="card-title">Bank Information</h3>
                            </div>
                            <div class="card-body">
                                <form method="post" action="/admin/member/editbank" id="bank-form">
                                    <input name="phone" type="hidden" id="phoneban">

                                    <div class="mb-3">
                                        <strong>
                                            <i class="fas fa-pencil-alt mr-1"></i>
                                            <span>Bank Name</span>
                                        </strong>
                                        <input type="text" class="form-control mt-1" id="bank_name" name="bank_name" placeholder="Enter Bank Name">
                                    </div>

                                    <div class="mb-3">
                                        <strong>
                                            <i class="fas fa-pencil-alt mr-1"></i>
                                            <span>Account Name</span>
                                        </strong>
                                        <input type="text" class="form-control mt-1" id="name" name="names" placeholder="Enter Account Name">
                                    </div>

                                    <div class="mb-3">
                                        <strong>
                                            <i class="far fa-file-alt mr-1"></i>
                                            <span>Account Number</span>
                                        </strong>
                                        <input type="text" class="form-control mt-1" id="stk" name="stk" placeholder="Enter Account Number">
                                    </div>

                                    <div class="mb-3">
                                        <strong>
                                            <i class="fas fa-map-marker-alt mr-1"></i>
                                            <span>IFSC Code</span>
                                        </strong>
