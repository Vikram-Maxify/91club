<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function() {
        // Login as User button
        $('#login-as-user').click(function() {
            Swal.fire({
                title: 'Login as User',
                text: 'Are you sure you want to login as this user?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#00807c',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, login',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire(
                        'Success!',
                        'You are now logged in as this user.',
                        'success'
                    );
                }
            });
        });

        // Active Withdraw button
        $('#active-withdraw').click(function() {
            Swal.fire({
                title: 'Active Withdraw',
                text: 'Do you want to activate withdrawals for this user?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#00807c',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Activate',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                
                 const id = $('#mobile-value').text();

                        $.post(
                          "/api/admin/enableWithdraw",
                          { phone:id, enable: 1 },
                          function (response) {
                            //location.reload();
                          }
                        );
                        
                
                    Swal.fire(
                        'Activated!',
                        'Withdrawals have been enabled for this user.',
                        'success'
                    );
                }
            });
        });
        
        // disabled Withdraw button
        $('#disabled-withdraw').click(function() {
            Swal.fire({
                title: 'Disabled Withdraw',
                text: 'Do you want to disabled withdrawals for this user?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#00807c',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Activate',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                
                 const id = $('#mobile-value').text();

                        $.post(
                          "/api/admin/enableWithdraw",
                          { phone:id, enable: 0 },
                          function (response) {
                            //location.reload();
                          }
                        );
                        
                
                    Swal.fire(
                        'Activated!',
                        'Withdrawals have been enabled for this user.',
                        'success'
                    );
                }
            });
        });

        // Wallet Update button
        $('#wallet-update').click(function() {
            Swal.fire({
                title: 'Wallet Update',
                html: `
                    <div class="text-left">
                        <div class="mb-3">
                            <label class="form-label">Amount</label>
                            <input type="number" id="wallet-amount" class="form-control" placeholder="Enter amount">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Action</label>
                            <select id="wallet-action" class="form-select">
                                <option value="add">Add Funds</option>
                                <option value="subtract">Subtract Funds</option>
                            </select>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonColor: '#00807c',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Update',
                cancelButtonText: 'Cancel',
                focusConfirm: false,
                preConfirm: () => {
                    const amount = document.getElementById('wallet-amount').value;
                    const action = document.getElementById('wallet-action').value;
                    const id = $('#uid-value').text();

                    if (!amount || isNaN(amount)) {
                        Swal.showValidationMessage('Please enter a valid amount');
                        return false;
                    }
                   
                   let buff_acc
                   if(action==="add"){
                   buff_acc=1
                   }else{
                   buff_acc=2
                   }
                    
                    
                    
                    $.ajax({
            type: "POST",
            url: "/admin/manager/settings/buff",
            data: {
              id_user:id,
              buff_acc: buff_acc,
              money_value: amount,
            },
            dataType: "json",
           
          });
          
                    
                    return { amount: amount, action: action }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire(
                        'Updated!',
                        `Wallet has been ${result.value.action === 'add' ? 'credited' : 'debited'} with ₹${result.value.amount}`,
                        'success'
                    );
                }
            });
        });

        // Ban User button
        $('#ban-user').click(function() {
            Swal.fire({
                title: 'Ban User',
                html: `
                    <div class="text-left">
                        <div class="mb-3">
                            <label class="form-label">Reason</label>
                            <select id="ban-reason" class="form-select">
                                <option value="violation">Terms Violation</option>
                                <option value="fraud">Suspected Fraud</option>
                                <option value="inactive">Inactive Account</option>
                                <option value="other">Other Reason</option>
                            </select>
                        </div>
                        <div class="mb-3" id="other-reason-container" style="display:none">
                            <label class="form-label">Specify Reason</label>
                            <input type="text" id="other-reason" class="form-control" placeholder="Enter reason">
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Ban User',
                cancelButtonText: 'Cancel',
                didOpen: () => {
                    document.getElementById('ban-reason').addEventListener('change', (e) => {
                        const otherContainer = document.getElementById('other-reason-container');
                        otherContainer.style.display = e.target.value === 'other' ? 'block' : 'none';
                    });
                },
                preConfirm: () => {
                    const reason = document.getElementById('ban-reason').value;
                    let fullReason = reason;
                   const id = $('#uid-value').text();

                        $.post(
                          "/api/webapi/admin/banned",
                          { id, type: "close" },
                          function (response) {
                            //location.reload();
                          }
                        );
                    
                    
                    return { reason: fullReason }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire(
                        'Banned!',
                        `User has been banned. Reason: ${result.value.reason}`,
                        'success'
                    );
                }
            });
        });
    });
</script>
    
    <script>
        // Utility functions
        function formatDate(timestamp) {
            if (!timestamp) return "N/A";
            const date = new Date(Number(timestamp));
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function formatCurrency(amount) {
            if (!amount) return "0.00";
            return parseFloat(amount).toFixed(2);
        }

        // Get member ID from URL
        function getMemberIdFromUrl() {
            const pathParts = window.location.pathname.split('/');
            return pathParts[pathParts.length - 1];
        }

        const memberId = getMemberIdFromUrl();

        // API endpoints
        const API_BASE = '/api/webapi/admin/member';
        const endpoints = {
            info: `${API_BASE}/info`,
            withdraw: `/admin/member/listWithdraw/${memberId}`,
            recharge: `/admin/member/listRecharge/${memberId}`,
            redenvelope: `/admin/member/redenvelope/${memberId}`,
            bet: `/admin/member/bet/${memberId}`
        };

        // Fetch member info
        function fetchMemberInfo() {
            $.ajax({
                type: "POST",
                url: endpoints.info,
                data: { phone: memberId },
                dataType: "json",
                success: function(response) {
                    if (response.status === false) {
                        console.error("Failed to fetch member info");
                        return;
                    }
                    console.log(response)
                    
                    const user = response.datas[0];
                    
                    // Update basic info cards
                    $("#username-value").text(user.name_user || "N/A");
                    $("#wallet-value").text(`₹${formatCurrency(user.money)}`);
                    $("#uid-value").text(user.id_user || "N/A");
                    $("#mobile-value").text(user.phone || "N/A");
                    
                    // Update profile card
                    $(".profile-username").text(user.name_user || "N/A");
                    $("#id_user").text(`ID: ${user.id_user || "N/A"}`);
                    $("#money").text(formatCurrency(user.money));
                    $("#total_mem").text((response.f1 + response.f2 + response.f3 + response.f4) || "0");
                    $("#ip").text(user.ip_address || "N/A");
                    $("#invite").text(response?.ng_moi?.phone || "N/A");
                    
                    $("#level").text(
                        user.level == 1 ? "ADMIN" : 
                        user.level == 2 ? "CTV" : "USER"
                    );
                    $("#total_money").text(formatCurrency(response.total_r[0]?.total));
                    $("#total_withdraw").text(formatCurrency(response.total_w[0]?.total));
                    
                    // Update subordinate cards
                    $("#direct-registrations").text(response.f1 || "0");
                    $("#team-registrations").text((response.f1 + response.f2 + response.f3 + response.f4) || "0");
                    
                    // Update bank info if available
                    if (response.bank_user[0]) {
                        $("#phoneban").val(response.bank_user[0].id);
                        $("#bank_name").val(response.bank_user[0].name_bank || "");
                        $("#name").val(response.bank_user[0].name_user || "");
                        $("#stk").val(response.bank_user[0].stk || "");
                        $("#upi").val(response.bank_user[0].sdt || "");
                        $("#ifsc").val(response.bank_user[0].email || "");
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Error fetching member info:", error);
                }
            });
        }

        // Table rendering functions
        function renderWithdrawTable(data) {
            if (!data || data.length === 0) {
                $("#list-withdraw").html(`
                    <tr class="text-center">
                        <td colspan="5">No withdrawal records found</td>
                    </tr>
                `);
                return;
            }
            
            let html = '';
            data.forEach(item => {
                html += `
                    <tr class="text-center">
                        <td style="color: #e74c3c;font-weight: 600;">${item.id_order || "N/A"}</td>
                        <td><b style="color: #3498db">₹${formatCurrency(item.money)}</b></td>
                        <td><b>${item.name_bank || "N/A"}</b></td>
                        <td>
                            <span class="badge ${item.status == "1" ? "bg-success" : "bg-danger"}">
                                ${item.status == "1" ? "Success" : "Failed"}
                            </span>
                        </td>
                        <td><b>${item.today}</b></td>
                    </tr>
                `;
            });
            $("#list-withdraw").html(html);
        }

        function renderRechargeTable(data) {
            if (!data || data.length === 0) {
                $("#list-recharge").html(`
                    <tr class="text-center">
                        <td colspan="5">No recharge records found</td>
                    </tr>
                `);
                return;
            }
            
            let html = '';
            data.forEach(item => {
                html += `
                    <tr class="text-center">
                        <td style="color: #e74c3c;font-weight: 600;">${item.transaction_id || "N/A"}</td>
                        <td><b style="color: #3498db">₹${formatCurrency(item.money)}</b></td>
                        <td><b>${item.type === "bank" ? "Bank Transfer" : "Mobile Payment"}</b></td>
                        <td>
                            <span class="badge ${item.status == "1" ? "bg-success" : "bg-warning"}">
                                ${item.status == "1" ? "Success" : "Pending"}
                            </span>
                        </td>
                        <td><b>${item.today}</b></td>
                    </tr>
                `;
            });
            $("#list-recharge").html(html);
        }

        function renderRedEnvelopeTable(data) {
            if (!data || data.length === 0) {
                $("#list-redenvelope").html(`
                    <tr class="text-center">
                        <td colspan="5">No red envelope records found</td>
                    </tr>
                `);
                return;
            }
            
            let html = '';
            data.forEach(item => {
                html += `
                    <tr class="text-center">
                        <td style="color: #e74c3c;font-weight: 600;">${item.phone || "N/A"}</td>
                        <td><b style="color: #3498db">₹${formatCurrency(item.money)}</b></td>
                        <td><b>${item.id_redenvelops || "N/A"}</b></td>
                        <td><span class="badge bg-success">Success</span></td>
                        <td><b>${item.time}</b></td>
                    </tr>
                `;
            });
            $("#list-redenvelope").html(html);
        }

        function renderBetTable(data) {
            if (!data || data.length === 0) {
                $("#list-bet").html(`
                    <tr class="text-center">
                        <td colspan="5">No bet records found</td>
                    </tr>
                `);
                return;
            }
            
            let html = '';
            data.forEach(item => {
                html += `
                    <tr class="text-center">
                        <td style="color: #e74c3c;font-weight: 600;">${item.stage || "N/A"}</td>
                        <td><b style="color: ${item.status == 1 ? "#2ecc71" : "#e74c3c"}">
                            ${item.status == 1 ? "+" : "-"} ₹${formatCurrency(item.money)}
                        </b></td>
                        <td><b>${item.game ? item.game.toUpperCase() : "N/A"} - ${item.source ? item.source.toUpperCase() : "N/A"}</b></td>
                        <td>
                            <span class="badge ${item.status == "1" ? "bg-success" : "bg-danger"}">
                                ${item.status == "1" ? "Win" : "Loss"}
                            </span>
                        </td>
                        <td><b>${item.date}</b></td>
                    </tr>
                `;
            });
            $("#list-bet").html(html);
        }

        // Pagination variables
        const pagination = {
            withdraw: { page: 1, limit: 15, totalPages: 1 },
            recharge: { page: 1, limit: 15, totalPages: 1 },
            redenvelope: { page: 1, limit: 15, totalPages: 1 },
            bet: { page: 1, limit: 30, totalPages: 1 }
        };

        // Fetch data with pagination
        function fetchWithdrawData() {
            $.ajax({
                type: "POST",
                url: endpoints.withdraw,
                data: {
                    typeid: "1",
                    pageno: (pagination.withdraw.page - 1) * pagination.withdraw.limit,
                    limit: pagination.withdraw.limit,
                    language: "vi"
                },
                dataType: "json",
                success: function(response) {
                    if (response.status === true) {
                        pagination.withdraw.totalPages = response.page_total;
                        $("#text-withdraw").text(`${pagination.withdraw.page} / ${pagination.withdraw.totalPages}`);
                        renderWithdrawTable(response.datas);
                        
                        // Enable/disable pagination buttons
                        $("#previousWithdraw").prop("disabled", pagination.withdraw.page <= 1);
                        $("#nextWithdraw").prop("disabled", pagination.withdraw.page >= pagination.withdraw.totalPages);
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Error fetching withdraw data:", error);
                }
            });
        }

        function fetchRechargeData() {
            $.ajax({
                type: "POST",
                url: endpoints.recharge,
                data: {
                    typeid: "1",
                    pageno: (pagination.recharge.page - 1) * pagination.recharge.limit,
                    limit: pagination.recharge.limit,
                    language: "vi"
                },
                dataType: "json",
                success: function(response) {
                    if (response.status === true) {
                        pagination.recharge.totalPages = response.page_total;
                        $("#text-recharge").text(`${pagination.recharge.page} / ${pagination.recharge.totalPages}`);
                        renderRechargeTable(response.datas);
                        
                        // Enable/disable pagination buttons
                        $("#previousRecharge").prop("disabled", pagination.recharge.page <= 1);
                        $("#nextRecharge").prop("disabled", pagination.recharge.page >= pagination.recharge.totalPages);
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Error fetching recharge data:", error);
                }
            });
        }

        function fetchRedEnvelopeData() {
            $.ajax({
                type: "POST",
                url: endpoints.redenvelope,
                data: {
                    typeid: "1",
                    pageno: (pagination.redenvelope.page - 1) * pagination.redenvelope.limit,
                    limit: pagination.redenvelope.limit,
                    language: "vi"
                },
                dataType: "json",
                success: function(response) {
                    if (response.status === true) {
                        pagination.redenvelope.totalPages = response.page_total;
                        $("#text-redenvelope").text(`${pagination.redenvelope.page} / ${pagination.redenvelope.totalPages}`);
                        renderRedEnvelopeTable(response.datas);
                        
                        // Enable/disable pagination buttons
                        $("#previousRedenvelope").prop("disabled", pagination.redenvelope.page <= 1);
                        $("#nextRedenvelope").prop("disabled", pagination.redenvelope.page >= pagination.redenvelope.totalPages);
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Error fetching red envelope data:", error);
                }
            });
        }

        function fetchBetData() {
            $.ajax({
                type: "POST",
                url: endpoints.bet,
                data: {
                    typeid: "1",
                    pageno: "1",
                    limit: pagination.bet.limit,
                    language: "vi"
                },
                dataType: "json",
                success: function(response) {
                    if (response.status === true) {
                        pagination.bet.totalPages = response.page_total;
                        $("#text-bet").text(`${pagination.bet.page} / ${pagination.bet.totalPages}`);
                        renderBetTable(response.datas);
                        
                        // Enable/disable pagination buttons
                        $("#previousBet").prop("disabled", pagination.bet.page <= 1);
                        $("#nextBet").prop("disabled", pagination.bet.page >= pagination.bet.totalPages);
                    }
                },
                error: function(xhr, status, error) {
                    console.error("Error fetching bet data:", error);
                }
            });
        }

        // Pagination event handlers
        $("#nextWithdraw").click(function() {
            if (pagination.withdraw.page < pagination.withdraw.totalPages) {
                pagination.withdraw.page++;
                fetchWithdrawData();
            }
        });

        $("#previousWithdraw").click(function() {
            if (pagination.withdraw.page > 1) {
                pagination.withdraw.page--;
                fetchWithdrawData();
            }
        });

        $("#nextRecharge").click(function() {
            if (pagination.recharge.page < pagination.recharge.totalPages) {
                pagination.recharge.page++;
                fetchRechargeData();
            }
        });

        $("#previousRecharge").click(function() {
            if (pagination.recharge.page > 1) {
                pagination.recharge.page--;
                fetchRechargeData();
            }
        });

        $("#nextRedenvelope").click(function() {
            if (pagination.redenvelope.page < pagination.redenvelope.totalPages) {
                pagination.redenvelope.page++;
                fetchRedEnvelopeData();
            }
        });

        $("#previousRedenvelope").click(function() {
            if (pagination.redenvelope.page > 1) {
                pagination.redenvelope.page--;
                fetchRedEnvelopeData();
            }
        });

        $("#nextBet").click(function() {
            if (pagination.bet.page < pagination.bet.totalPages) {
                pagination.bet.page++;
                fetchBetData();
            }
        });

        $("#previousBet").click(function() {
            if (pagination.bet.page > 1) {
                pagination.bet.page--;
                fetchBetData();
            }
        });

        // Initialize all data on page load
        $(document).ready(function() {
            fetchMemberInfo();
            fetchWithdrawData();
            fetchRechargeData();
            fetchRedEnvelopeData();
            fetchBetData();
        });
    </script>
</body>
</html>