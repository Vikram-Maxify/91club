                                <span id="text-redenvelope">1 / 1</span>
                                <button id="nextRedenvelope" class="btn btn-sm btn-dark-teal" disabled>Next</button>
                            </div>
                        </div>

                        <!-- Bet Table -->
                        <div class="data-table">
                            <div class="table-header">
                                <h3><i class="fas fa-dice mr-2"></i>Bet History</h3>
                            </div>
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Stage</th>
                                        <th>Amount</th>
