                                    </div>

                                    <div class="mb-3">
                                        <strong>
                                            <i class="fas fa-map-marker-alt mr-1"></i>
                                            <span>USDT</span>
                                        </strong>
                                        <input type="text" class="form-control mt-1" id="upi" name="upi" placeholder="Enter UPI">
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-block" style="background: var(--primary-teal); border: none; padding: 12px 20px; font-size: 16px; font-weight: bold; color: white; border-radius: 30px;">
                                        <b style="text-transform: uppercase;">Edit</b>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tables Section -->
                <div class="row mt-4">
                    <div class="col-md-12">
