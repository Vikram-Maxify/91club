<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Member List</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback" />
    <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@sweetalert2/theme-minimal/minimal.css">
    <style>
        :root {
            --primary-teal: #5ccfcb;
            --dark-teal: #00807c;
            --card-blue: #3b82f6;
            --card-green: #22c55e;
            --card-purple: #8b5cf6;
            --card-orange: #f97316;
            --card-red: #ef4444;
            --text-light: #ffffff;
            --bg-light: #f3f4f6;
            --border-radius-lg: 1rem;
            --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.15);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            line-height: 1.6;
            color: #333;
        }

        .container-fluid {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .content-header {
            background-color: var(--dark-teal);
            color: white;
            padding: 1rem;
            border-radius: var(--border-radius-lg);
            margin-bottom: 2rem;
        }

        .content-header h1 {
            font-weight: 600;
            margin: 0;
        }

        .dashboard-card {
        background-color: var(--text-light);
        border-radius: var(--border-radius-lg);
        padding: 1.5rem;
        box-shadow: var(--shadow-md);
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        text-align: left;
        border: 1px solid var(--border-light);
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .dashboard-card .icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        align-self: flex-start;
        color: var(--primary-teal);
    }

    .dashboard-card .label {
        font-size: 0.9rem;
        opacity: 0.8;
        color: #666;
    }

    .dashboard-card .value {
        font-size: 1.8rem;
        font-weight: 600;
        margin-top: 0.25rem;
        color: var(--text-dark);
    }

    .action-button {
        width: 100%;
        border-radius: var(--border-radius-lg);
        padding: 1rem 1.5rem;
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--text-light);
        border: none;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .action-button:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
        opacity: 0.9;
    }

    .action-button .icon {
        margin-right: 0.75rem;
        font-size: 1.2rem;
    }

    .btn-teal { 
        background-color: var(--primary-teal); 
        border: 1px solid var(--primary-teal);
    }
    .btn-teal:hover {
        background-color: var(--dark-teal);
        border-color: var(--dark-teal);
    }
    
    .btn-dark-teal { 
        background-color: var(--dark-teal);
        border: 1px solid var(--dark-teal);
    }
    .btn-dark-teal:hover {
        background-color: #00504d;
        border-color: #00504d;
    }
    
    .btn-red { 
        background-color: var(--card-red);
        border: 1px solid var(--card-red);
    }
    .btn-red:hover {
        background-color: #dc2626;
        border-color: #dc2626;
    }
    
    .btn-green { 
        background-color: var(--card-green);
        border: 1px solid var(--card-green);
    }
    .btn-green:hover {
        background-color: #16a34a;
        border-color: #16a34a;
    }

        .card-username { border-left: 5px solid var(--card-blue); }
        .card-wallet { border-left: 5px solid var(--card-green); }
        .card-uid { border-left: 5px solid var(--card-purple); }
        .card-mobile { border-left: 5px solid var(--card-orange); }

        .card-teal {
            background-color: var(--primary-teal);
            color: var(--text-light);
        }
        
        .card-teal .label,
        .card-teal .value {
            color: var(--text-light);
        }

        .card-dark-teal {
            background-color: var(--dark-teal);
            color: var(--text-light);
        }
        
        .card-dark-teal .label,
        .card-dark-teal .value {
            color: var(--text-light);
        }

        .action-button {
            width: 100%;
            border-radius: var(--border-radius-lg);
            padding: 1rem 1.5rem;
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--text-light);
            border: none;
            box-shadow: var(--shadow-md);
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out, opacity 0.2s ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .action-button:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
            opacity: 0.9;
            color: var(--text-light);
        }

        .action-button .icon {
            margin-right: 0.75rem;
            font-size: 1.2rem;
        }

        .btn-teal { background-color: var(--primary-teal); }
        .btn-dark-teal { background-color: var(--dark-teal); }
        .btn-red { background-color: var(--card-red); }
        .btn-blue { background-color: var(--card-blue); }
        .btn-green { background-color: var(--card-green); }
        .btn-orange { background-color: var(--card-orange); }

        .subordinate-card {
            background-color: var(--text-light);
            border-radius: var(--border-radius-lg);
            padding: 2rem;
            box-shadow: var(--shadow-md);
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: none;
        }

        .subordinate-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }

        .subordinate-card h3 {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
        }

        .subordinate-card h3 .icon {
            font-size: 1.8rem;
            margin-right: 0.75rem;
        }

        .subordinate-card .metrics-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        @media (min-width: 576px) {
            .subordinate-card .metrics-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .subordinate-card .metric-item {
            background-color: rgba(255, 255, 255, 0.15);
            padding: 1rem;
            border-radius: 0.75rem;
            text-align: center;
        }

        .subordinate-card .metric-label {
            font-size: 0.85rem;
            opacity: 0.8;
            margin-bottom: 0.25rem;
        }

        .subordinate-card .metric-value {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .subordinate-card-blue { background-color: var(--card-blue); color: white; }
        .subordinate-card-purple { background-color: var(--card-purple); color: white; }
        .subordinate-card-teal { background-color: var(--primary-teal); color: white; }
        .subordinate-card-dark-teal { background-color: var(--dark-teal); color: white; }

        .profile-card {
            border: none;
            border-radius: 15px;
            background: linear-gradient(135deg, var(--primary-teal), var(--dark-teal));
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            color: white;
            overflow: hidden;
        }

        .profile-card .profile-user-img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 4px solid white;
            box-shadow: 0 4px 10px rgba(255, 255, 255, 0.3);
        }

        .profile-card .list-group-item {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            padding: 15px 20px;
            color: white;
            display: flex;
            justify-content: space-between;
        }

        .profile-card .list-group-item:nth-child(even) {
            background: rgba(255, 255, 255, 0.2);
        }

        .profile-card .list-group-item a {
            color: #ffeb3b;
            font-weight: bold;
            background: transparent !important;
        }

        .bank-card {
            border: none;
            border-radius: 15px;
            background: linear-gradient(135deg, var(--dark-teal), #006663);
            color: white;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

        .bank-card .card-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .bank-card .form-control {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            border-radius: 10px;
        }

        .bank-card .form-control::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .data-table {
            background-color: white;
            border-radius: var(--border-radius-lg);
            box-shadow: var(--shadow-md);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .data-table .table-header {
            background-color: var(--dark-teal);
            color: white;
            padding: 1rem;
            border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
        }

        .data-table .table-header h3 {
            margin: 0;
            font-weight: 600;
        }

        .data-table thead {
            background-color: var(--dark-teal);
            color: white;
        }

        .data-table th {
            font-weight: 500;
        }

        .data-table .badge {
            font-weight: 500;
            padding: 5px 10px;
            border-radius: 20px;
        }

        .pagination-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            background-color: white;
            border-radius: 0 0 var(--border-radius-lg) var(--border-radius-lg);
        }

        .row.g-3 {
            --bs-gutter-x: 1rem;
            --bs-gutter-y: 1rem;
        }

        @media (min-width: 992px) {
            .row.g-3 {
                --bs-gutter-x: 1.5rem;
                --bs-gutter-y: 1.5rem;
            }
        }

        @media (max-width: 768px) {
            .dashboard-card .value {
                font-size: 1.5rem;
            }
            
            .subordinate-card h3 {
                font-size: 1.5rem;
            }
            
            .action-button {
                padding: 0.8rem 1rem;
                font-size: 1rem;
            }
        }
    </style>
</head>

<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <%- include('nav') %>
        <div class="content-wrapper">
            <section class="">
                <div class="container-fluid">
                    <div class="row ">
                        <div class="col-sm-6">
                            <h1>Member Information</h1>
                        </div>
                    </div>
                </div>
            </section>

            <div class="container-fluid">
                <!-- Row 1: User Info Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="dashboard-card card-username">
                            <i class="fas fa-user icon"></i>
                            <div class="label">Username</div>
                            <div class="value" id="username-value">Loading...</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="dashboard-card card-wallet">
                            <i class="fas fa-wallet icon"></i>
                            <div class="label">Wallet Amount</div>
                            <div class="value" id="wallet-value">Loading...</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="dashboard-card card-uid">
                            <i class="fas fa-fingerprint icon"></i>
                            <div class="label">UID</div>
                            <div class="value" id="uid-value">Loading...</div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="dashboard-card card-mobile">
                            <i class="fas fa-phone icon"></i>
