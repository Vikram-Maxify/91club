                                        <td colspan="5" class="text-center">Loading data...</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="pagination-controls">
                                <button id="previousBet" class="btn btn-sm btn-dark-teal" disabled>Previous</button>
                                <span id="text-bet">1 / 1</span>
                                <button id="nextBet" class="btn btn-sm btn-dark-teal" disabled>Next</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

