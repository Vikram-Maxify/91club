                            <div class="value" id="mobile-value">Loading...</div>
                        </div>
                    </div>
                </div>

               <!-- Row 2: Action Buttons -->
<div class="row g-3 mb-4">
    
    <div class="col-12 col-sm-6 col-lg-3">
        <button class="action-button btn-dark-teal" id="active-withdraw">
            <i class="fas fa-money-bill-wave icon"></i>Active Withdraw
