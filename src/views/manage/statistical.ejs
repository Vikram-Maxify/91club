                  <span class="totalWin">0</span>
                </div>
              </div>

              <div
                onclick="location.href='/admin/manager/betting?today=loss'"
                class="grid-item"
              >
                <span class="icon red-bg"
                  ><i class="fas fa-times-circle"></i
                ></span>
                <div class="info">
                  <span>Losses Count</span><br />
                  <span class="totalLossCount">0</span>
                </div>
              </div>

              <div
                onclick="location.href='/admin/manager/betting?today=loss'"
                class="grid-item"
              >
                <span class="icon red-bg"
                  ><i class="fas fa-times-circle"></i
                ></span>
                <div class="info">
