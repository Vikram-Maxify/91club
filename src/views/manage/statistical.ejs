              >
                <span class="icon yellow-bg"
                  ><i class="fas fa-exchange-alt"></i
                ></span>
                <div class="info">
                  <span>Withdrawals Today</span><br />
                  <span class="totalwithdrawToday">0</span>
                </div>
              </div>

              <div class="grid-item">
                <span class="icon"><i class="fas fa-chart-line"></i></span>
                <div class="info">
